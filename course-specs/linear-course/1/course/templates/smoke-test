// the instructions' placeholders that appear twice with different dummies per file are keyed above once
const files = {
  yaml: ['course.yaml'],
  md: ['plan.md', 'glossary.md', 'storyline.md', 'CHANGELOG.md'],
  learner: ['learner/apprenant.md', 'learner/observations.md', 'learner/parcours.md'],
};

function stripHeader(name, text) {
  if (name.endsWith('.yaml')) return text.replace(/^(#.*\n)+/, '');
  return text.replace(/^<!--[\s\S]*?-->\n/, '');
}
function fill(name, text) {
  text = stripHeader(name, text);
  if (name.endsWith('.svg')) text = text.replace(/&lt;/g, '<').replace(/&gt;/g, '>');
  // an optional part of a cell (`[, <variant>]`) is filled too
  text = text.replace(/\[(, <[^>\n]+>)\]/g, '$1');
  const keys = Object.keys(DUMMY).sort((a, b) => b.length - a.length);
  for (const k of keys) text = text.split('<' + k + '>').join(DUMMY[k]);
  return text;
}
function leftovers(name, text) {
  const body = name.endsWith('.yaml') ? text.replace(/^\s*#.*$/gm, '') : text;
  return (body.match(/<[^>\n]*[A-Za-z][^>\n]*>/g) || []).filter((m) => !/^<\/?(rect|text|g|title|desc|svg)\b/.test(m));
}

let bad = 0;
const keep = process.argv.includes('--keep');
const list = process.argv.includes('--list');
function build(withDiagram) {
  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'templates-smoke-'));
  const course = path.join(tmp, 'smoke');
  const put = (rel, text, srcName) => {
    const left = leftovers(srcName, text);
    if (left.length) { console.log(`FAIL ${srcName}: unreplaced placeholder ${left.slice(0, 3).join(' ')}`); bad++; }
    fs.mkdirSync(path.dirname(path.join(course, rel)), { recursive: true });
    fs.writeFileSync(path.join(course, rel), text);
  };
  // the learner templates are the teacher's, read from teacher/templates/
  const read = (n) => fs.readFileSync(path.join(files.learner.includes(n) ? teacher : here, n), 'utf8');
  const out = (n) => fill(n, read(n));
  for (const n of [...files.yaml, ...files.md]) put(n, out(n), n);
  put('domains/1-bases.md', out('domain.md'), 'domain.md');
  const dir = 'concepts/00-roles/';
  for (const n of ['sources.md']) put(dir + n, out(n), n);
  let concept = out('concept.md');
  if (withDiagram) put(dir + 'schema.svg', out('diagram.svg'), 'diagram.svg');
  else concept = concept.replace(/^diagrams:\n(  .*\n)+/m, '');
  put(dir + 'concept.md', concept, 'concept.md');
  for (const n of files.learner) { const left = leftovers(n, out(n)); if (left.length) { console.log(`FAIL ${n}: unreplaced placeholder ${left[0]}`); bad++; } }
  return { tmp, course };
}
for (const withDiagram of [true, false]) {
  const { tmp, course } = build(withDiagram);
  // a reporting failure leaves the exit code 0: the test reads the failure lines, not the code alone
  const r = spawnSync(process.execPath, [path.join(spec, 'course', 'checks', 'check-course'), course], { encoding: 'utf8' });
  const notOk = r.stdout.split('\n').filter((l) => l && !l.endsWith(': ok') && !l.startsWith('summary: '));
  const ok = r.status === 0 && !notOk.length;
  console.log(`${ok ? 'ok  ' : 'FAIL'} templates ${withDiagram ? 'with' : 'without'} a diagram pass every check, blocking and reporting${ok ? '' : ': ' + (notOk.join(' | ') || r.stderr)}`);
  if (!ok) bad++;
  if (keep) console.log('kept: ' + tmp); else fs.rmSync(tmp, { recursive: true, force: true });
}
if (list) {
  const seen = new Set();
  const scan = [...fs.readdirSync(here, { recursive: true }).map((n) => path.join(here, n)), ...files.learner.map((n) => path.join(teacher, n))];
  for (const f of scan) if (/\.(md|yaml|svg)$/.test(f)) for (const m of fs.readFileSync(f, 'utf8').matchAll(/(?:<|&lt;)([^<>\n&]+?)(?:>|&gt;)/g)) seen.add(m[1]);
  console.log([...seen].filter((k) => !(k in DUMMY)).join('\n'));
}
process.exit(bad ? 1 : 0);
