#!/usr/bin/env node
'use strict';
// check-course <course-dir> [--category <c>[,<c>...]] [--only <id>[,<id>...]] [--concept <number>] [--lexicon <file>]
// check-course [--category <c>[,<c>...]] --list
// The checks, their category and their severity come from course/rules.yaml (lib/rules.js; decision
// `severity-from-level-and-method`): by default every check of method test that runs on a course, the
// blocking ones first, then the reporting ones, each in the order of course/rules.yaml. A failure
// of a blocking check sets exit code 1; a failure of a reporting check is printed and leaves 0.
// lib/ is the one of the spec directives that spec.yaml declares (./directives.js).
const path = require('path');
const directives = require('./directives');
const { load } = directives.lib('course');
const rules = directives.lib('rules');

const QUALITY_GONE = '--quality is gone: the reporting checks run by default, and --category <c> selects checks by category (check-course --list)';
// the lexicon of the course files of this MAJOR, unless --lexicon names another (the fixtures')
const LEXICON = path.join(__dirname, '..', 'lexicon.yaml');

let RULES;
try { RULES = rules.load(__dirname); } catch (e) {
  if (!(e instanceof rules.RulesError)) throw e;
  console.error(`check-course: ${e.message}`);
  process.exit(2);
}
const HERE = RULES.checks.filter((c) => c.runsHere);
const ORDERED = [...HERE.filter((c) => c.severity === 'blocks'), ...HERE.filter((c) => c.severity === 'reports')];

function usage(code) {
  const out = code ? console.error : console.log;
  out('usage: check-course <course-dir> [--category <c>[,<c>...]] [--only <id>[,<id>...]] [--concept <number>] [--lexicon <file>]');
  out('       check-course [--category <c>[,<c>...]] --list');
  out('runs every check of method test of course/rules.yaml; a failure of a blocking check sets exit code 1,');
  out('a failure of a reporting check leaves it 0');
  out(`categories: ${RULES.categories.join(', ')}`);
  out(`blocking checks: ${ORDERED.filter((c) => c.severity === 'blocks').map((c) => c.id).join(', ')}`);
  out(`reporting checks: ${ORDERED.filter((c) => c.severity === 'reports').map((c) => c.id).join(', ')}`);
  process.exit(code);
}
function refuse(message) {
  console.error(message);
  process.exit(2);
}
const ids = (v) => String(v || '').split(',').filter(Boolean);

const args = process.argv.slice(2);
let dir = null;
const only = [];
const categories = [];
const opts = { specLexicon: LEXICON };
let list = false;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === '--help' || a === '-h') usage(0);
  else if (a === '--list') list = true;
  else if (a === '--quality') refuse(QUALITY_GONE);
  else if (a === '--category') categories.push(...ids(args[++i]));
  else if (a.startsWith('--category=')) categories.push(...ids(a.slice(11)));
  else if (a === '--only') only.push(...ids(args[++i]));
  else if (a.startsWith('--only=')) only.push(...ids(a.slice(7)));
  else if (a === '--concept') opts.concept = args[++i];
  else if (a.startsWith('--concept=')) opts.concept = a.slice(10);
  else if (a === '--lexicon') opts.lexicon = path.resolve(args[++i] || '');
  else if (a.startsWith('--lexicon=')) opts.lexicon = path.resolve(a.slice(10));
  else if (a.startsWith('-')) { console.error(`unknown option ${a}`); usage(2); }
  else if (dir === null) dir = a;
  else usage(2);
}
for (const c of categories) {
  if (!RULES.categories.includes(c)) refuse(`unknown category "${c}" (categories of course/rules.yaml: ${RULES.categories.join(', ')})`);
}
const inCategories = (c) => !categories.length || categories.includes(c.category);

if (list) {
  // every check of course/rules.yaml, those check-course does not run included, with how they run
  const rows = [...ORDERED, ...RULES.checks.filter((c) => !c.runsHere)].filter(inCategories);
  const w = Math.max(...rows.map((c) => c.id.length));
  const wc = Math.max(...rows.map((c) => c.category.length));
  for (const c of rows) console.log(`${c.id.padEnd(w)}  ${c.category.padEnd(wc)}  ${c.severity.padEnd(7)}${c.runsHere ? '' : `  not run here: ${c.how}`}`.trimEnd());
  process.exit(0);
}
if (dir === null) usage(2);
for (const id of only) {
  const c = RULES.checks.find((x) => x.id === id);
  if (!c) refuse(`unknown check id "${id}" (check-course --list)`);
  if (!c.runsHere) refuse(`"${id}" is not run by check-course: ${c.how}`);
  if (!inCategories(c)) refuse(`"${id}" is in category ${c.category}, which --category does not select`);
}

const fs = require('fs');
if (!fs.existsSync(dir) || !fs.statSync(dir).isDirectory()) refuse(`not a directory: ${dir}`);

const ctx = load(dir, opts);
const run = ORDERED.filter(inCategories).filter((c) => !only.length || only.includes(c.id));
const failed = { blocks: [], reports: [] };
let crashed = false;
for (const c of run) {
  let failures;
  try {
    failures = require('./' + c.id).run(ctx);
  } catch (e) {
    // a check that crashed did not run: exit code 1, whatever its severity
    crashed = true;
    failures = [{ file: 'check-course', line: 1, message: `the check crashed: ${e.stack.split('\n').slice(0, 3).join(' | ')}` }];
  }
  if (!failures.length) console.log(`${c.id}: ok`);
  else {
    failed[c.severity].push(c.id);
    for (const f of failures) console.log(`${c.id}: fail: ${f.file}:${f.line} ${f.message}`);
  }
}
const count = (sev) => {
  const n = run.filter((c) => c.severity === sev).length;
  return `${n} ${sev === 'blocks' ? 'blocking' : 'reporting'} check${n === 1 ? '' : 's'}, ${failed[sev].length} failed${failed[sev].length ? ` (${failed[sev].join(', ')})` : ''}`;
};
const code = failed.blocks.length || crashed ? 1 : 0;
console.log(`summary: ${count('blocks')}; ${count('reports')}; exit ${code}`);
process.exit(code);
