---
// The shell of every page, ported from the old site's src/layouts/Base.astro: the skip link, the
// header (the course title as brand; the navigation, whose words come from the document; search;
// the theme toggle), the main content, indexed by Pagefind unless `noindex`, and the footer
// (the link to the about page; the band of the course: who answers for it, its licence, linked to
// its page on the SPDX list, its creation and its last update, a date git could not give left out;
// and its version: its number, or « version non publiée » while it has none, no version when the
// document does not give it). `nav` is the key of the URL scheme's page the header marks as current.
// The page's language is the document's (`language`, its spec MAJOR's): the engine writes none.
// The look is the course's (src/lib/look.ts): its logo in the header, painted in the accent through
// `currentColor`; the accent family and the focus as custom properties, per theme; the favicon and the
// share image the build writes from them; `theme-color`, the accent of each theme. `og:url` and
// `og:image` are absolute addresses, written only when the build is given an origin (`Astro.site`,
// build-site's `--origin`); `og:url` not on a page out of the index (the search page, the 404 page,
// served at any address no page has).
import '../styles/global.css';
import { doc, words, pageHref, href, hasPage } from '../lib/site';
import { ui } from '../ui';
import { logo, tokensCss, accent } from '../lib/look';
import Magnifier from '../icons/loupe.svg';
import Sun from '../icons/soleil.svg';
import Moon from '../icons/lune.svg';

interface Props {
  title?: string;
  nav?: string;
  /** A page out of the index: neither in the Pagefind search nor for search engines. */
  noindex?: boolean;
}
const { title, nav, noindex = false } = Astro.props;
const course = doc.course;
const fullTitle = title ? `${title} | ${course.title}` : course.title;
const items = [
  { key: 'domains', label: words.site.nav.domains },
  { key: 'storyline', label: words.site.nav.storyline },
  { key: 'glossary', label: words.site.nav.glossary },
].filter((i) => hasPage(i.key));
const release = doc.release;
// the band of the course: its maintainers as a list in the page's language, its dates written out
const maintainers = new Intl.ListFormat(doc.language, { type: 'conjunction' }).format(course.maintainers);
const day = (d: string | null) => (d ? new Intl.DateTimeFormat(doc.language, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${d}T00:00:00Z`)) : null);
const created = day(course.created);
const updated = day(course.updated);
const headerLogo = logo({ width: '28', height: '28', 'aria-hidden': 'true', focusable: 'false' });
const site = Astro.site;
---
<!doctype html>
<html lang={doc.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {course.subtitle && <meta name="description" content={course.subtitle} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={accent.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={accent.dark} media="(prefers-color-scheme: dark)" />
    <style is:inline set:html={tokensCss}></style>
    <meta property="og:title" content={fullTitle} />
    {site && !noindex && <meta property="og:url" content={new URL(Astro.url.pathname, site).href} />}
    {site && <meta property="og:image" content={new URL(href('share.png'), site).href} />}
    <script is:inline>
      document.documentElement.classList.add('js');
      // The theme the reader chose (the header's button), applied before the page shows; otherwise the system's.
      try {
        var theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">{ui.skip}</a>
    <header class="site-header">
      <div class="container-wide bar">
        <a class="brand" href={pageHref('home')} aria-current={nav === 'home' ? 'page' : undefined}>
          <Fragment set:html={headerLogo} />
          <span class="brand-nom">{course.title}</span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-list" hidden>{ui.menu}</button>
        <nav class="site-nav" aria-label={ui.mainNav}>
          <ul id="nav-list">
            {items.map((i) => (
              <li><a href={pageHref(i.key)} aria-current={nav === i.key ? 'page' : undefined}>{i.label}</a></li>
            ))}
          </ul>
        </nav>
        <a class="btn-rond search-link" href={pageHref('search')} title={ui.search} aria-current={nav === 'search' ? 'page' : undefined}>
          <Magnifier width="18" height="18" aria-hidden="true" />
          <span class="sr-only">{ui.search}</span>
        </a>
        <button class="btn-rond theme-toggle" type="button" hidden data-label={ui.themeDark} data-to-light={ui.toLight} data-to-dark={ui.toDark}>
          <Sun class="icone-soleil" width="18" height="18" aria-hidden="true" />
          <Moon class="icone-lune" width="18" height="18" aria-hidden="true" />
          <span class="sr-only"></span>
        </button>
      </div>
    </header>
    <script is:inline>
      // The light / dark button: switches the theme shown and remembers the choice.
      (function () {
        var b = document.querySelector('.theme-toggle');
        if (!b) return;
        var root = document.documentElement;
        var systemDark = window.matchMedia('(prefers-color-scheme: dark)');
        function current() { return root.getAttribute('data-theme') || (systemDark.matches ? 'dark' : 'light'); }
        function update() {
          var dark = current() === 'dark';
          b.setAttribute('aria-pressed', dark ? 'true' : 'false');
          b.querySelector('.sr-only').textContent = b.getAttribute('data-label');
          b.title = dark ? b.getAttribute('data-to-light') : b.getAttribute('data-to-dark');
        }
        b.hidden = false;
        b.addEventListener('click', function () {
          var t = current() === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', t);
          try { localStorage.setItem('theme', t); } catch (e) {}
          update();
        });
        systemDark.addEventListener('change', update);
        update();
      })();
    </script>
    <script is:inline>
      // The menu button on a narrow screen: folds and unfolds the navigation; Escape folds it.
      (function () {
        var b = document.querySelector('.nav-toggle');
        var l = document.getElementById('nav-list');
        if (!b || !l) return;
        b.hidden = false;
        document.documentElement.classList.add('nav-js');
        b.addEventListener('click', function () {
          var open = b.getAttribute('aria-expanded') === 'true';
          b.setAttribute('aria-expanded', open ? 'false' : 'true');
          l.parentNode.classList.toggle('is-open', !open);
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && b.getAttribute('aria-expanded') === 'true') {
            b.setAttribute('aria-expanded', 'false'); l.parentNode.classList.remove('is-open'); b.focus();
          }
        });
      })();
    </script>
    <main id="content" data-pagefind-body={noindex ? undefined : ''}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container-wide row">
        <p><a href={pageHref('about')} aria-current={nav === 'about' ? 'page' : undefined}>{ui.about}</a></p>
        <p class="footer-meta course-meta" data-pagefind-ignore>
          <span class="maintainers">{ui.maintainedBy} {maintainers}</span>
          {' · '}<span class="license">{ui.license} <a href={`https://spdx.org/licenses/${course.license}.html`} rel="license">{course.license}</a></span>
          {created && <>{' · '}<span class="created">{ui.created} <time datetime={course.created!}>{created}</time></span></>}
          {updated && <>{' · '}<span class="updated">{ui.updated} <time datetime={course.updated!}>{updated}</time></span></>}
        </p>
        {release !== undefined && (
          <p class="footer-meta version" data-pagefind-ignore>{release ? `${ui.version} ${release.version}` : ui.unreleased}</p>
        )}
      </div>
    </footer>
  </body>
</html>
