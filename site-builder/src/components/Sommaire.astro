---
// The sticky table of contents of a long page, ported from the old site's Sommaire: a column on the
// left on desktop, a bar of pills at the top on a phone; the part being read is highlighted. Put
// first in a `.avec-sommaire` block, the content in `.sommaire-contenu`. One per page. `compact`:
// short items (the letters of the glossary) side by side on desktop, the last on its own line.
interface Item { id: string; n?: number | string; title: string }
interface Props { items: Item[]; label: string; compact?: boolean }
const { items, label, compact = false } = Astro.props;
---
<nav class:list={['sommaire', { 'sommaire-compact': compact }]} aria-label={label} data-pagefind-ignore>
  <ol>
    {items.map((i) => (
      <li><a href={`#${i.id}`} data-sommaire={i.id}>{i.n !== undefined && <span class="sommaire-n">{i.n}</span>}<span class="sommaire-t">{i.title}</span></a></li>
    ))}
  </ol>
</nav>

<script is:inline>
  (function () {
    function init() {
      var nav = document.querySelector('nav.sommaire');
      if (!nav) return;
      var list = nav.querySelector('ol');
      var links = Array.prototype.slice.call(nav.querySelectorAll('a[data-sommaire]'));
      var parts = links.map(function (a) { return document.getElementById(a.getAttribute('data-sommaire')); });
      if (!links.length || parts.some(function (s) { return !s; })) return;
      var active = null;
      function activate(i) {
        if (i === active) return;
        active = i;
        links.forEach(function (a, j) {
          if (j === i) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
        });
        // The horizontal bar (phone): brings the active pill into view, without moving the page.
        if (list.scrollWidth > list.clientWidth) {
          var ra = links[i].getBoundingClientRect(), rl = list.getBoundingClientRect();
          list.scrollBy({ left: ra.left + ra.width / 2 - (rl.left + rl.width / 2), behavior: 'smooth' });
        }
      }
      // The active part is the last whose top has passed the third of the screen; at the bottom of
      // the page, the last part.
      function activeIndex() {
        var threshold = window.innerHeight / 3, i = 0;
        parts.forEach(function (s, j) { if (s.offsetParent !== null && s.getBoundingClientRect().top <= threshold) i = j; });
        if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) i = parts.length - 1;
        return i;
      }
      function compute() { activate(activeIndex()); }
      var waiting = false;
      window.addEventListener('scroll', function () {
        if (waiting) return;
        waiting = true;
        requestAnimationFrame(function () { waiting = false; compute(); });
      }, { passive: true });
      window.addEventListener('resize', compute);
      window.addEventListener('load', compute);
      window.addEventListener('hashchange', compute);
      document.addEventListener('toggle', compute, true);
      compute();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
