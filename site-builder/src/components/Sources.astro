---
// The « Sources » of a concept page: the sources its claim marks cite, in the order of their ids,
// each under the anchor `source-<id>` its claim marks link to (`sourceAnchor`), formatted from its
// CSL fields: its authors, its title (in quotes when its CSL type is a part of a container, an
// article, a post, an entry; in italics otherwise), a link on its URL, its container, its date of
// publication; then its kind, its control and its independence, words of the course lexicon, and
// the date it was read, after the site lexicon's `labels.accessed`. Its quotes and its `checked`
// are not in the document, so never here.
import type { Source, CslName } from '../lib/site';
import { sourceAnchor, words } from '../lib/site';
interface Props { sources: Source[] }
const { sources } = Astro.props;
/** The CSL types of a work that stands alone, its title in italics; any other is a part of its container. */
const whole = new Set(['book', 'report', 'standard', 'thesis', 'dataset', 'software', 'manuscript', 'pamphlet', 'document', 'map', 'patent', 'legislation', 'regulation']);
const name = (n: CslName) => n.literal ?? [n.given, n.family].filter(Boolean).join(' ');
const names = (list?: CslName[]) => (list ?? []).map(name).join(', ');
---
<ol class="reflist sources">
  {sources.map((s) => {
    const authors = names(s.author);
    const quoted = !whole.has(s.type ?? '');
    const title = quoted ? `« ${s.title} »` : s.title;
    const link = s.URL ?? (s.DOI ? `https://doi.org/${s.DOI}` : undefined);
    const meta = [s.kind, s.control, s.independence].join(' · ');
    return (
      <li id={sourceAnchor(s.id)}>
        <span class="id">{s.id}</span>
        <span>
          {authors && <>{authors}, </>}
          {link
            ? <a href={link} rel="noopener">{quoted ? title : <cite>{title}</cite>}</a>
            : (quoted ? title : <cite>{title}</cite>)}
          {s['container-title'] && <>, <cite>{s['container-title']}</cite></>}
          {s.issued !== undefined && <>, {String(s.issued)}</>}
          <span class="meta" data-pagefind-ignore>{meta}{s.accessed && ` · ${words.site.labels.accessed} ${s.accessed}`}</span>
        </span>
      </li>
    );
  })}
</ol>
