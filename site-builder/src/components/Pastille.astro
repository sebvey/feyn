---
// The badge of a nature, ported from the old site's Pastille: a tint, a shape and the word of the
// course lexicon's `natures` (or of the site lexicon's stance column); out of the search index.
// `kind` is the nature's key (`consensus`, `school`, `fact`, `course`), `word` the word it shows.
import { badge } from '../lib/site';
interface Props { kind: string; word: string }
const { kind, word } = Astro.props;
---
<Fragment set:html={badge(kind, word)} />
