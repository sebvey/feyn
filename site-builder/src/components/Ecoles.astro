---
// « Consensus et choix d'école », built from the claim marks of a concept, ported from the old
// site's Ecoles: three columns, one per stance (`consensus`, `school`, `course`), each headed by the
// badge of the site lexicon's `stance_columns` word and its intro line (`intros`); in each, the
// claim marks of that nature, in the order of the page, each with its holder when sources.yaml
// gives one, its text, a link back to its place in the page, and its sources. A fact is no stance: its
// claim marks have their badge in the text, and no column here.
import type { ClaimMark } from '../lib/site';
import { words } from '../lib/site';
import Pastille from './Pastille.astro';
import Refs from './Refs.astro';
interface Props { marks: ClaimMark[] }
const { marks } = Astro.props;
const columns = (['consensus', 'school', 'course'] as const).map((key) => ({ key, items: marks.filter((k) => k.nature === key) }));
const cls: Record<string, string> = { consensus: 'consensus', school: 'ecole', course: 'cours' };
---
<div class="ecoles">
  {columns.map((c) => (
    <section class={`col ${cls[c.key]}`} aria-labelledby={`col-${c.key}`}>
      <h3 id={`col-${c.key}`}><Pastille kind={c.key} word={words.site.stance_columns?.[c.key] ?? c.key} /></h3>
      {words.site.intros?.[c.key] && <p class="col-intro">{words.site.intros[c.key]}</p>}
      {c.items.length > 0 && (
        <ul>
          {c.items.map((k) => (
            <li>
              {k.holder && <span class="auteur">{k.holder}</span>}
              <a href={`#${k.anchor}`}>{k.text}</a>{' '}
              <Refs refs={k.sources} />
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</div>
