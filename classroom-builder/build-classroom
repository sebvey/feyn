#!/usr/bin/env node
'use strict';
// build-classroom <course-dir> [--out <dir>] [--channel next|prod|preview] [--site-url <base>] [--force]
// Builds a classroom outside the repository from a course, in two halves (classroom-builder/README.md):
//   1. the dispatcher: it reads `spec: <name>@<MAJOR>` in course.yaml and runs that MAJOR's
//      course-specs/<name>/<MAJOR>/teacher/build/render-parts, which renders the five parts of its
//      composition as text, one JSON document validated here against the MAJOR's parts.schema.yaml;
//   2. the Claude Code realisation of those parts, this file's own:
//      permanent       CLAUDE.md, from CLAUDE.template.md
//      on-demand       .claude/skills/feyn-teacher-<moment>/SKILL.md, one per moment that has rules
//      course-reads    course/, the course folder copied as is
//      learner-memory  learner/, the learner templates
//      permissions     .claude/settings.json
//   then course.lock and the classroom's own git, one commit holding all of it.
// The form of the protocol and of the composition is the MAJOR's: nothing here reads them.
// Exit 0 built, 1 an input the build cannot read (render-parts failed, its output not valid),
// 2 a usage error or a refused target (a spec or MAJOR with no teacher/build/render-parts).
const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawnSync } = require('child_process');
const { createRequire } = require('module');

const BUILDER = __dirname;
const REPO = path.resolve(BUILDER, '..');
const CHANNELS = ['next', 'prod', 'preview'];

function usage(code) {
  const out = code ? console.error : console.log;
  out('usage: build-classroom <course-dir> [--out <dir>] [--channel next|prod|preview] [--site-url <base>] [--force]');
  out('builds the classroom of <course-dir> at <dir>, by default ~/classrooms/<course id>-next/ (channel next)');
  out('or ~/classrooms/<course id>/ (channel prod); a target that exists and is not empty is refused');
  out('unless --force, which empties it first; without --site-url the site addresses are « (site non publié) »');
  process.exit(code);
}
function refuse(message) {
  console.error(`build-classroom: ${message}`);
  process.exit(2);
}
function fail(message) {
  console.error(`build-classroom: ${message}`);
  process.exit(1);
}

// ---- arguments
const opts = { force: false, channel: null, out: null, siteUrl: null };
let courseDir = null;
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  const value = () => {
    if (i + 1 >= argv.length) refuse(`${a} needs a value`);
    return argv[++i];
  };
  if (a === '--help' || a === '-h') usage(0);
  else if (a === '--force') opts.force = true;
  else if (a === '--out') opts.out = value();
  else if (a === '--channel') opts.channel = value();
  else if (a === '--site-url') opts.siteUrl = value();
  else if (a.startsWith('-')) refuse(`unknown option ${a}`);
  else if (courseDir === null) courseDir = a;
  else refuse(`one course folder only (got ${courseDir} and ${a})`);
}
if (courseDir === null) usage(2);
const channel = opts.channel || 'next';
if (!CHANNELS.includes(channel)) refuse(`channel "${channel}" is not one of ${CHANNELS.join(', ')}`);
if (channel === 'preview' && !opts.out) refuse('channel preview has no default folder: give --out');
courseDir = path.resolve(courseDir);

const read = (p) => {
  try { return fs.readFileSync(p, 'utf8'); } catch (e) { return fail(`cannot read ${path.relative(process.cwd(), p) || p}`); }
};
const rel = (p) => path.relative(REPO, p);

// ---- the dispatcher: the spec MAJOR the course declares, and its render-parts
const courseYamlText = read(path.join(courseDir, 'course.yaml'));
const specLine = courseYamlText.split('\n').find((l) => /^spec\s*:/.test(l));
const specRef = specLine && specLine.replace(/^spec\s*:\s*/, '').replace(/\s+#.*$/, '').trim().replace(/^(['"])(.*)\1$/, '$2');
const specMatch = specRef && /^([a-z0-9]+(?:-[a-z0-9]+)*)@(\d+)$/.exec(specRef);
if (!specMatch) fail(`${courseDir}/course.yaml declares no spec (spec: <name>@<MAJOR>)`);
const SPEC = path.join(REPO, 'course-specs', specMatch[1], specMatch[2]);
if (!fs.existsSync(path.join(SPEC, 'spec.yaml'))) refuse(`unknown spec MAJOR ${specRef}: no ${rel(SPEC)}/spec.yaml`);
const RENDER = path.join(SPEC, 'teacher', 'build', 'render-parts');
const SCHEMA = path.join(SPEC, 'teacher', 'build', 'parts.schema.yaml');
if (!fs.existsSync(RENDER)) refuse(`the spec MAJOR ${specRef} has no teacher/build/render-parts: no classroom is built from it`);
if (!fs.existsSync(SCHEMA)) refuse(`the spec MAJOR ${specRef} has no teacher/build/parts.schema.yaml`);
const dirLine = read(path.join(SPEC, 'spec.yaml')).split('\n').find((l) => /^directives\s*:/.test(l));
const directives = dirLine && dirLine.replace(/^directives\s*:\s*/, '').replace(/\s+#.*$/, '').trim();
if (!/^\d+$/.test(directives || '')) fail(`${rel(SPEC)}/spec.yaml declares no directives MAJOR`);
const DIRECTIVES = path.join(REPO, 'spec-directives', directives);
require(path.join(DIRECTIVES, 'lib', 'deps')).need();
const yaml = require(path.join(DIRECTIVES, 'lib', 'yaml-lines'));
const Ajv2020 = createRequire(path.join(DIRECTIVES, 'package.json'))('ajv/dist/2020').default;
const template = read(path.join(BUILDER, 'CLAUDE.template.md'));

// ---- the parts, rendered by the MAJOR and validated against its schema
const renderArgs = [courseDir, '--channel', channel, ...(opts.siteUrl ? ['--site-url', opts.siteUrl] : [])];
const rendered = spawnSync(process.execPath, [RENDER, ...renderArgs], { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 });
if (rendered.error) fail(`cannot run ${rel(RENDER)}: ${rendered.error.message}`);
if (rendered.status !== 0) {
  process.stderr.write(rendered.stderr || '');
  fail(`${rel(RENDER)} exits ${rendered.status}`);
}
let parts;
try { parts = JSON.parse(rendered.stdout); } catch (e) { fail(`${rel(RENDER)} prints no JSON: ${e.message}`); }
let validate;
try { validate = new Ajv2020({ allErrors: true }).compile(yaml.parse(read(SCHEMA))); } catch (e) { fail(`${rel(SCHEMA)}: ${e.message}`); }
if (!validate(parts)) {
  fail(`the output of ${rel(RENDER)} is not valid against ${rel(SCHEMA)}: ${validate.errors.map((e) => `${e.instancePath || '/'} ${e.message}`).join('; ')}`);
}
if (parts.spec !== specRef) fail(`${rel(RENDER)} rendered the parts of ${parts.spec}, not of ${specRef}`);
const course = parts.params.course;

// ---- the target folder
const out = path.resolve(opts.out || path.join(os.homedir(), 'classrooms', channel === 'prod' ? course.id : `${course.id}-next`));
if (fs.existsSync(out)) {
  if (!fs.statSync(out).isDirectory()) refuse(`${out} exists and is not a folder`);
  if (fs.readdirSync(out).length) {
    if (!opts.force) refuse(`${out} exists and is not empty (learner memory may live there): give --force to rebuild it`);
    // --force empties a classroom only: a folder with no course.lock may be anything (a typo of --out)
    if (!fs.existsSync(path.join(out, 'course.lock'))) refuse(`${out} is not empty and holds no course.lock, so it is not a classroom: --force refused`);
    fs.rmSync(out, { recursive: true, force: true });
    console.error(`build-classroom: --force: ${out} emptied`);
  }
}

// ---- git facts of the sources
function git(cwd, ...args) {
  const r = spawnSync('git', args, { cwd, encoding: 'utf8' });
  return r.status === 0 ? r.stdout.trim() : null;
}
const tag = git(courseDir, 'describe', '--tags', '--exact-match', '--match', `${course.id}/v*`, 'HEAD');
const branch = git(courseDir, 'rev-parse', '--abbrev-ref', 'HEAD');
const ref = tag || (branch && branch !== 'HEAD' ? branch : git(courseDir, 'rev-parse', 'HEAD'));
const courseSha = git(courseDir, 'log', '-1', '--format=%H', '--', '.');
const toolingSha = git(REPO, 'log', '-1', '--format=%H', '--', path.relative(REPO, BUILDER), path.relative(REPO, path.dirname(RENDER)));
if (!courseSha) fail(`${courseDir} is not in a git repository with a commit`);
if (channel === 'prod' && !tag) {
  console.error(`build-classroom: channel prod is built from a course tag ${course.id}/v* (decision three-channels); this build reads ${ref}`);
}
if (git(courseDir, 'status', '--porcelain', '--', '.')) {
  console.error('build-classroom: the course folder has uncommitted changes: course_sha is its last commit, not what is copied');
}
let site = null;
if (opts.siteUrl) site = opts.siteUrl.endsWith('/') ? opts.siteUrl : opts.siteUrl + '/';

// ---- the skills of the moments: a moment with rules is a teacher skill, feyn-teacher-<moment>
// (the prefix keeps it apart from a skill of Claude Code itself, /resume)
const skillName = (m) => `feyn-teacher-${m.id}`;
const hasRules = (m) => m.rules.trim() !== '';
function skill(m) {
  const description = `Load at this moment of a teaching session: ${m.when}. Holds the rules of the moment ${m.id}.`;
  // a draw given as text (the section of a course file under a heading) is written out, so that
  // the moment needs no read of that file
  const reads = m.draws.map((d) => (d.text
    ? `- \`${d.path}\`: ${d.what}, given here (no need to read the file):\n\n${d.text.split('\n').map((l) => (l.trim() ? `  ${l}` : '')).join('\n')}\n`
    : `- \`${d.path}\`: ${d.what}`));
  const uses = m.slots.length ? ['', ...m.slots.map((s) => `\`${s.slot}\` is ${s.meaning}.`)] : [];
  return [
    '---',
    `name: ${skillName(m)}`,
    `description: ${JSON.stringify(description)}`,
    '---',
    '',
    `# ${skillName(m)}`,
    '',
    `The moment \`${m.id}\`: ${m.when}. Its rules below hold beside those of \`CLAUDE.md\`.`,
    '',
    ...(reads.length ? ['What it reads:', '', ...reads, ...uses, ''] : []),
    m.rules,
    '',
  ].join('\n');
}
const withRules = parts.moments.filter(hasRules);
const momentList = parts.moments.map((m) => (hasRules(m)
  ? `- \`${m.id}\` (skill \`${skillName(m)}\`): ${m.when}.`
  : `- \`${m.id}\`: ${m.when}; no rule yet, no skill.`)).join('\n');

// ---- CLAUDE.md
const claude = template
  .replace(/^<!--[\s\S]*?-->\n/, '')
  .replace(/\{\{([a-z_]+)\}\}/g, (m, k) => {
    const v = {
      course_title: course.title,
      spec: specRef,
      channel,
      posture: parts.permanent.posture,
      course_map: parts.permanent.course_map,
      course_files: parts.permanent.course_files,
      moments: momentList,
      protocol: parts.permanent.protocol,
    }[k];
    if (v === undefined) fail(`CLAUDE.template.md: unknown slot {{${k}}}`);
    return v;
  });

// ---- write the classroom
fs.mkdirSync(out, { recursive: true });
fs.writeFileSync(path.join(out, 'CLAUDE.md'), claude.replace(/\n*$/, '\n'));
fs.cpSync(courseDir, path.join(out, 'course'), { recursive: true });
fs.mkdirSync(path.join(out, 'learner'));
for (const t of parts.learner_templates) fs.writeFileSync(path.join(out, 'learner', t.name), t.text);
for (const m of withRules) {
  fs.mkdirSync(path.join(out, '.claude', 'skills', skillName(m)), { recursive: true });
  fs.writeFileSync(path.join(out, '.claude', 'skills', skillName(m), 'SKILL.md'), skill(m));
}
// part permissions: each writable folder added and, when the part says so, committed; a read-only
// folder never edited nor written; no push unless the part allows it
const perms = parts.permissions;
const settings = {
  permissions: {
    allow: [...perms.writable.map((f) => `Bash(git add ${f})`), ...(perms.commit ? ['Bash(git commit:*)'] : [])],
    deny: [...perms.read_only.flatMap((f) => [`Edit(${f}**)`, `Write(${f}**)`]), ...(perms.push ? [] : ['Bash(git push:*)'])],
  },
};
fs.mkdirSync(path.join(out, '.claude'), { recursive: true });
fs.writeFileSync(path.join(out, '.claude', 'settings.json'), JSON.stringify(settings, null, 2) + '\n');
const lock = {
  course: course.id,
  ref,
  course_sha: courseSha,
  tooling_sha: toolingSha,
  channel,
  site_url: site,
  built_at: new Date().toISOString().replace(/\.\d{3}Z$/, 'Z'),
};
fs.writeFileSync(path.join(out, 'course.lock'), [
  '# The record of this classroom (classroom-builder/build-classroom): the course, the ref and the',
  '# commit it was read from, the commit of the build, the channel, the site address, the date.',
  ...Object.entries(lock).map(([k, v]) => `${k}: ${v === null ? 'null' : JSON.stringify(v)}`),
  '',
].join('\n'));

// ---- the classroom's own git, one commit
const run = (...args) => {
  const r = spawnSync('git', args, { cwd: out, encoding: 'utf8' });
  if (r.status !== 0) fail(`git ${args.join(' ')} failed in ${out}: ${(r.stderr || '').trim()}`);
};
run('init', '-q', '-b', 'main');
run('add', '-A');
run('commit', '-q', '-m', `classroom ${course.id}: built from ${ref} at ${courseSha.slice(0, 12)}`);
console.log(`build-classroom: ${out} built (${course.id}, channel ${channel}, ${withRules.length} skills)`);
