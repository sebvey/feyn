{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch --list:*)",
      "Bash(mise exec -- gh issue view:*)",
      "Bash(mise exec -- gh issue list:*)",
      "Bash(mise exec -- gh pr view:*)",
      "Bash(mise exec -- gh pr list:*)",
      "Bash(mise exec -- gh project item-list:*)",
      "Bash(course-specs/check-course:*)",
      "Bash(mise exec -- course-specs/check-course:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch -c:*)",
      "Bash(git ls-remote:*)",
      "Bash(mise exec -- gh issue create:*)",
      "Bash(mise exec -- gh issue edit:*)",
      "Bash(mise exec -- gh project item-add:*)",
      "Bash(mise exec -- gh project item-edit:*)",
      "Bash(mise exec -- gh pr create:*)"
    ]
  }
}
