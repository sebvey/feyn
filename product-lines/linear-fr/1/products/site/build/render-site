#!/usr/bin/env node
'use strict';
// render-site <course-dir> [--form <file>]
// The half of a site build that depends on this spec MAJOR: it reads a course through the parser
// of this MAJOR, course/parser.js, and its readers of the concept references, of the claim marks and
// of the glossary, course/refs.js, course/claims.js and course/glossary.js, the ones the course checks
// use, given the lib of the spec directives this MAJOR follows (with md.js of that lib), keeps the
// parts course/form.yaml names `published: true`
// (closed by default: a part the form does not name, or names without `published: true`, is
// never output), and prints them to stdout as one JSON document, whose shape site.schema.yaml
// fixes and README.md (this folder) describes, with the words of products/site/lexicon.yaml, the headings
// of course/lexicon.yaml the published parts carry, the URL scheme of products/site/url-scheme.yaml and the
// language of spec.yaml, so that the site engine reads no course file and no spec file. It names
// no mechanism of a target and rewrites no course text. Writes nothing. Exit 0 rendered, 1 an
// input it cannot read, 2 a usage error.
const fs = require('fs');
const path = require('path');
const { createRequire } = require('module');

// here is product-lines/<name>/<MAJOR>/products/site/build
const MAJOR = path.resolve(__dirname, '..', '..', '..');
const REPO = path.resolve(MAJOR, '..', '..', '..');

function usage(code) {
  const out = code ? console.error : console.log;
  out('usage: render-site <course-dir> [--form <file>]');
  out('prints the published parts of <course-dir> as JSON (README.md); --form reads another form');
  out('than the MAJOR\'s course/form.yaml, for the test');
  process.exit(code);
}
function fail(message) {
  console.error(`render-site: ${message}`);
  process.exit(1);
}

// ---- arguments
let courseDir = null;
let formFile = path.join(MAJOR, 'course', 'form.yaml');
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--help' || a === '-h') usage(0);
  else if (a === '--form') {
    if (i + 1 >= argv.length) { console.error('render-site: --form needs a value'); usage(2); }
    formFile = path.resolve(argv[++i]);
  } else if (a.startsWith('-')) { console.error(`render-site: unknown option ${a}`); usage(2); }
  else if (courseDir === null) courseDir = a;
  else { console.error(`render-site: one course folder only (got ${courseDir} and ${a})`); usage(2); }
}
if (courseDir === null) usage(2);
courseDir = path.resolve(courseDir);

const rel = (p) => path.relative(process.cwd(), p) || p;
const read = (p) => {
  try { return fs.readFileSync(p, 'utf8'); } catch (e) { return fail(`cannot read ${rel(p)}`); }
};

// ---- the spec directives this MAJOR follows (spec.yaml, `directives: <MAJOR>`): their lib and package
const specYaml = read(path.join(MAJOR, 'spec.yaml'));
const lineOf = (key) => {
  const l = specYaml.split('\n').find((x) => new RegExp(`^${key}\\s*:`).test(x));
  return l && l.replace(new RegExp(`^${key}\\s*:\\s*`), '').replace(/\s+#.*$/, '').trim().replace(/^(['"])(.*)\1$/, '$2');
};
const directives = lineOf('directives');
if (!/^\d+$/.test(directives || '')) fail(`${rel(MAJOR)}/spec.yaml declares no directives MAJOR`);
const DIRECTIVES = path.join(REPO, 'spec-directives', directives);
if (!fs.existsSync(path.join(DIRECTIVES, 'package.json'))) fail(`no spec directives at ${rel(DIRECTIVES)}`);
const req = createRequire(path.join(DIRECTIVES, 'package.json'));
req('./lib/deps').need();
const yaml = req('./lib/yaml-lines');
const md = req('./lib/md');
const { normNumber, RELEASE } = req('./lib/common');
// the parser of a course and the readers of its concept references, of its claim marks and of its
// glossary are this MAJOR's, given the directives' lib
const lib = (name) => req('./lib/' + name);
const course = require(path.join(MAJOR, 'course', 'parser.js'))(lib);
const refs = require(path.join(MAJOR, 'course', 'refs.js'))(lib);
const claims = require(path.join(MAJOR, 'course', 'claims.js'))(lib);
const glossary = require(path.join(MAJOR, 'course', 'glossary.js'))(lib);
const SPEC = `${lineOf('name')}@${lineOf('major')}`;
// the language of the MAJOR's courses and lexicons (ISO 639-1), given to the engine for the pages it writes
const LANGUAGE = lineOf('language');
if (!/^[a-z]{2}$/.test(LANGUAGE || '')) fail(`${rel(MAJOR)}/spec.yaml declares no language (ISO 639-1)`);

const parseYaml = (p) => {
  try { return yaml.parse(read(p)); } catch (e) { return fail(`${rel(p)}: ${e.message}`); }
};

// ---- the course, through the lib, with the MAJOR's lexicon and the form
const ctx = course.load(courseDir, { specLexicon: path.join(MAJOR, 'course', 'lexicon.yaml'), specForm: formFile });
if (!ctx.cy) fail(`${rel(courseDir)}: ${ctx.cyError ? ctx.cyError.message : 'no course.yaml'}`);
if (ctx.cy.spec !== SPEC) fail(`${rel(courseDir)}/course.yaml declares spec ${ctx.cy.spec}, not ${SPEC}`);
if (!ctx.usable) fail(`${rel(courseDir)}/course.yaml has no domains or no concepts (check-course says more)`);
if (!ctx.lexiconOk) fail(ctx.lexiconError.message);
if (!ctx.form) fail(ctx.formError);
const form = ctx.form;
const siteLexicon = parseYaml(path.join(MAJOR, 'products', 'site', 'lexicon.yaml'));
const urlScheme = parseYaml(path.join(MAJOR, 'products', 'site', 'url-scheme.yaml'));

// published: a part of the form is rendered when it says `published: true`, and only then
const pub = (part) => !!part && part.published === true;
const H = (key) => {
  const w = ctx.word('headings', key);
  if (!w) fail(`course/lexicon.yaml has no headings.${key}`);
  return w;
};
// the Markdown of a run of lines, as the course writes it
const text = (lines) => lines.map((l) => l.t).join('\n').trim();
const mdOf = (file) => {
  const m = ctx.md(file);
  if (!m) fail(`${rel(path.join(courseDir, file))} cannot be read`);
  return m;
};
// the ## sections a form lists (`sections: [{ heading, published }]`), the published ones, as
// { key, heading, text }, or with `table` the table each holds
function sectionsOf(file, list, table) {
  const secs = md.sections(mdOf(file).body, 2).sections;
  return (list || []).filter(pub).map((p) => {
    const s = secs.find((x) => x.title === H(p.heading));
    if (!s) return null;
    const out = { key: p.heading, heading: H(p.heading) };
    if (!table) return { ...out, text: text(s.lines) };
    const t = md.tables(s.lines)[0];
    return { ...out, header: t ? t.header : [], rows: t ? t.rows.map((r) => r.cells) : [] };
  }).filter(Boolean);
}

// ---- the addresses, from products/site/url-scheme.yaml: {n} a domain's number, {nn} a concept's on
// `digits` digits, an annex as its id; the anchor of a diagram, {file} its file name without `.svg`
const pages = urlScheme.pages || {};
const nn = (urlScheme.placeholders || {}).nn || {};
if (typeof pages.domain !== 'string' || typeof pages.concept !== 'string') fail('products/site/url-scheme.yaml has no pages.domain or pages.concept');
if (!Number.isInteger(nn.digits) || nn.annex !== 'id') fail('products/site/url-scheme.yaml: placeholders.nn needs `digits` (an integer) and `annex: id`');
const anchors = urlScheme.anchors || {};
if (typeof anchors.diagram !== 'string' || !anchors.diagram.includes('{file}')) fail('products/site/url-scheme.yaml has no anchors.diagram with its {file}');
const domainPath = (n) => pages.domain.replace('{n}', String(n));
const diagramAnchor = (file) => anchors.diagram.replace('{file}', file.replace(/\.svg$/, ''));
const conceptPath = (c) => pages.concept.replace('{nn}', c.annex ? c.number : c.number.padStart(nn.digits, '0'));

// ---- the course map, course.yaml
if (!pub(form.course_map)) fail('course/form.yaml: the course map (course_map) is not published, the site has nothing to lay out');
const cy = ctx.cy;
// the look of the course on its site, both as the course declares them: its logo, the text of the
// file the form names (`logo`), and its accent colour (`site.accent_color` of course.yaml); the
// engine derives the rest (the favicon, the share image, the accent of each theme)
if (!pub(form.logo) || typeof form.logo.file !== 'string') fail('course/form.yaml: the logo (logo) is not published, the site has no logo to show');
const logo = read(path.join(courseDir, form.logo.file));
const accentColor = cy.site && cy.site.accent_color;
if (typeof accentColor !== 'string') fail(`${rel(courseDir)}/course.yaml has no site.accent_color (check-course says more)`);
const domainOf = new Map();
const domains = cy.domains.map((d) => {
  const concepts = (d.concepts || []).map(normNumber);
  for (const n of concepts) domainOf.set(n, d.number);
  return {
    number: d.number,
    slug: d.slug,
    title: d.title,
    objective: d.objective,
    duration_min: d.duration_min,
    concepts,
    path: domainPath(d.number),
    sections: sectionsOf(d.file, form.domain_file && form.domain_file.sections),
  };
});

// ---- the claim marks of the course and its sources.yaml, through course/claims.js, read once: the
// claim marks of each concept, in the parts that state claims, and who holds the stance of each
const readClaims = claims.reader(ctx);
if (!readClaims) fail('course/lexicon.yaml has no natures: no claim mark can be read');
const courseClaims = claims.ofCourse(ctx, readClaims);
if (courseClaims.error) fail(`${rel(path.join(courseDir, courseClaims.file))}, line ${courseClaims.error.line}: ${courseClaims.error.message}`);
const sourcesData = courseClaims.data || {};
const holders = (sourcesData.claims && typeof sourcesData.claims === 'object') ? sourcesData.claims : {};

// ---- a concept: its concept.md through course/parser.js (its tree and its parts), its frontmatter,
// its diagrams, its claim marks
const cf = form.concept_file || {};
const unitForm = form.unit || {};
const blockForms = Array.isArray(unitForm.blocks) ? unitForm.blocks : [];
const fieldsOf = (fields) => Object.fromEntries(fields.map((f) => [f.key, f.body]));
// the id of a misconception, its anchor on the concept page: its unit's id, then its name in
// lowercase ASCII words joined by hyphens, a hyphen more while another misconception of the unit has it
const slug = (t) => t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
function misconceptionIds(u) {
  const lesson = blockForms.find((b) => b.misconceptions);
  const ids = new Map();
  for (const f of u.fields.filter((x) => lesson && x.key === lesson.misconceptions.field)) {
    for (const m of f.items) {
      if (!m.name || ids.has(m.name)) continue;
      let id = `${u.sub.id}-${slug(m.name)}`;
      while ([...ids.values()].includes(id)) id += '-';
      ids.set(m.name, id);
    }
  }
  return ids;
}
// the misconceptions of a field (« Idées fausses »): each its id, its name, its belief and its parts by key
const misconceptionsOf = (f, spec, ids) => f.items.map((m) => ({ id: ids.get(m.name), name: m.name, belief: m.belief, ...Object.fromEntries((spec.parts || []).map((k) => [k, m[k] || ''])) }));
// a case: its title, from its heading; its fields, those of `revealed` under `revealed`, which the
// site shows hidden until the reader reveals them; the misconceptions in play, each its name and
// the id of the misconception of its unit it names (none for a name that matches none)
function caseOf(c, spec, ids) {
  const ip = spec.in_play && spec.in_play.field;
  const hidden = new Set(spec.revealed || []);
  const out = { title: c.title };
  const revealed = {};
  for (const f of c.fields) {
    const v = f.key === ip ? (f.names || []).map((n) => (ids.has(n.name) ? { name: n.name, id: ids.get(n.name) } : { name: n.name })) : f.body;
    if (hidden.has(f.key)) revealed[f.key] = v;
    else out[f.key] = v;
  }
  if (Object.keys(revealed).length) out.revealed = revealed;
  out.supplementary = !c.first;
  return out;
}
// a unit's published blocks, in the order the site renders them: the lesson (its matter), the
// cases, then the misconceptions of the lesson, after the cases, so that the site does not give a
// misconception away before the question (decision `misconception-is-matter`)
function unitOf(u) {
  const blocks = {};
  let misconceptions = null;
  const ids = misconceptionIds(u);
  for (const b of u.blocks) {
    const bf = blockForms.find((x) => x.block === b.key);
    if (!pub(bf)) continue;
    if (bf.cases) blocks[b.key] = b.cases.map((c) => caseOf(c, bf.cases, ids));
    else if (bf.labelled) {
      const mf = bf.misconceptions && b.fields.find((f) => f.key === bf.misconceptions.field);
      blocks[b.key] = fieldsOf(b.fields.filter((f) => f !== mf));
      if (mf) misconceptions = [...(misconceptions || []), ...misconceptionsOf(mf, bf.misconceptions, ids)];
    } else blocks[b.key] = text(b.fields[0].lines);
  }
  if (misconceptions) blocks.misconceptions = misconceptions;
  return { id: u.sub.id, title: u.sub.title, blocks };
}
// the claim marks of a concept that stand in a published part, each { url, nature, sources, name,
// holder, text, anchor }: `url` the link's destination as the reader read it, the key the engine
// renders the link by; `holder` from `claims` of sources.yaml, when it names one; `text` the plain
// text claimed; `anchor` the id of its place on the concept page: the misconception it stands in
// (its root or its correction), else its unit (its matter), else the key of its part (the head, a
// block of the foot). A claim mark in a part the form does not publish never reaches the document.
function claimMarksOf(c, parts) {
  const found = courseClaims.concepts.find((x) => x.c === c);
  if (!found) return [];
  const where = form.claims || {};
  const anchorOf = new Map(); // line -> anchor
  const put = (lines, anchor) => { for (const l of lines || []) anchorOf.set(l.n, anchor); };
  if (pub(cf.head) && parts.head) put(parts.head.lines, parts.head.key);
  if (pub(cf.foot) && parts.foot) {
    for (const b of parts.foot.blocks) {
      if ((where.foot_blocks || []).includes(b.key) && pub(((cf.foot || {}).blocks || []).find((x) => x.heading === b.key))) put(b.lines, b.key);
    }
  }
  for (const u of parts.units) {
    const ids = misconceptionIds(u);
    for (const f of u.fields) {
      if (f.case) continue;
      if (!pub(blockForms.find((b) => (b.fields || []).includes(f.key)))) continue;
      if ((where.unit_fields || []).includes(f.key)) put(f.lines, u.sub.id);
      for (const m of f.items || []) {
        for (const p of m.parts || []) if ((where.misconception_parts || []).includes(p.key) && ids.has(m.name)) put(p.lines, ids.get(m.name));
      }
    }
  }
  return found.marks.filter((k) => anchorOf.has(k.line)).map((k) => {
    const held = k.key && holders[k.key] && typeof holders[k.key].holder === 'string' ? holders[k.key].holder : null;
    return { url: k.node.url, nature: k.nature, sources: k.sources, name: k.name, ...(held ? { holder: held } : {}), text: k.text, anchor: anchorOf.get(k.line) };
  });
}
function conceptOf(c) {
  const e = c.entry;
  const file = `${c.dir}/${cf.file || 'concept.md'}`;
  const m = mdOf(file);
  const parts = ctx.parts(c);
  const out = {
    number: c.number,
    annex: c.annex,
    slug: e.slug,
    title: e.title,
    objective: e.objective,
    prerequisites: (e.prerequisites || []).map(normNumber),
    duration_min: e.duration_min,
    domain: domainOf.has(c.number) ? domainOf.get(c.number) : null,
    path: conceptPath(c),
  };
  if (pub(cf.head) && parts.head) out.head = { key: parts.head.key, heading: H(parts.head.key), text: text(parts.head.lines) };
  if (pub(cf.sections)) {
    out.sections = parts.sections.map((s) => ({
      id: s.sub.id,
      title: s.sub.title,
      units: parts.units.filter((u) => u.sub.parent === s.sub).map(unitOf),
    }));
  }
  if (pub(cf.foot) && parts.foot) {
    const blocks = parts.foot.blocks.filter((b) => pub(((cf.foot || {}).blocks || []).find((x) => x.heading === b.key)))
      .map((b) => ({ key: b.key, heading: H(b.key), text: text(b.lines) }));
    if (blocks.length) out.foot = { heading: H(cf.foot.heading), blocks };
  }
  const fm = cf.frontmatter_fields || {};
  const data = m.data || {};
  if (pub(fm.diagrams) && data.diagrams) out.diagrams = data.diagrams.map((d) => ({ ...d, anchor: diagramAnchor(d.file), svg: read(path.join(courseDir, c.dir, d.file)) }));
  out.claim_marks = claimMarksOf(c, parts);
  return out;
}
const concepts = ctx.concepts.map(conceptOf);

// ---- sources.yaml, published: each source in the order of its id, its CSL fields, its CSL `type`
// (its own, else the one `sources_file.csl_type` of the form gives its kind), its kind, its control
// and its independence, as written; never its quotes nor its `checked`, an audit material. No key
// when the form does not publish it; an empty list when the course has no sources.yaml.
const sf = form.sources_file || {};
const CSL = ['type', 'title', 'author', 'editor', 'container-title', 'publisher', 'volume', 'issue', 'page', 'number', 'version', 'issued', 'URL', 'DOI', 'accessed'];
const kindKey = new Map(Object.entries(ctx.lexicon.source_kinds || {}).map(([k, w]) => [w, k]));
let sources;
if (pub(sf)) {
  const all = (sourcesData.sources && typeof sourcesData.sources === 'object') ? sourcesData.sources : {};
  sources = Object.keys(all).filter((id) => claims.SOURCE_ID.test(id)).sort((a, b) => Number(a.slice(1)) - Number(b.slice(1))).map((id) => {
    const s = all[id] || {};
    const out = { id };
    const type = s.type !== undefined ? s.type : (sf.csl_type || {})[kindKey.get(s.kind)];
    if (typeof type === 'string') out.type = type;
    for (const k of CSL) if (k !== 'type' && s[k] !== undefined) out[k] = s[k];
    for (const k of ['kind', 'control', 'independence']) if (s[k] !== undefined) out[k] = s[k];
    return out;
  });
}

// ---- plan.md, its published sections
const plan = form.plan ? sectionsOf(form.plan.file, form.plan.sections) : [];

// ---- storyline.md: the world only (its H1, its text, its ## sections of free titles); a ## section
// under a heading the form names for another part of the file is not the world's, and the site
// never renders it (the teacher's, course/form.yaml)
const st = form.storyline || {};
let storyline = null;
if (st.file && ctx.exists(st.file)) {
  const body = mdOf(st.file).body;
  const h1 = md.headings(body).find((h) => h.level === 1);
  const split = md.sections(body, 2);
  const named = Object.values(st).filter((p) => p && typeof p === 'object' && p.heading).map((p) => H(p.heading));
  storyline = {};
  if (pub(st.world)) {
    storyline.world = {
      title: h1 ? h1.text : null,
      text: text(split.pre.filter((l) => !h1 || l.n !== h1.line)),
      sections: split.sections.filter((s) => !named.includes(s.title)).map((s) => ({ heading: s.title, text: text(s.lines) })),
    };
  }
}

// ---- glossary.md: its first table, then its published ## sections
const gl = form.glossary || {};
let courseGlossary = null;
if (gl.file && ctx.exists(gl.file)) {
  courseGlossary = {};
  const t = pub(gl.table) ? glossary.table(mdOf(gl.file)) : null;
  if (t) courseGlossary.table = { header: t.header, rows: t.rows.map((r) => r.cells) };
  courseGlossary.sections = sectionsOf(gl.file, gl.sections, true);
}

// ---- CHANGELOG.md: its latest release, its version and its date; null with none
const ch = form.changelog || {};
let release;
if (pub(ch.latest_release)) {
  release = null;
  if (ch.file && ctx.exists(ch.file)) {
    for (const s of md.sections(mdOf(ch.file).body, 2).sections) {
      const r = RELEASE.exec(s.title);
      if (r) { release = { version: r[1], date: r[5] }; break; }
    }
  }
}

// ---- the words: products/site/lexicon.yaml whole, and of course/lexicon.yaml those the published parts
// carry: the headings and the unit fields and blocks the form names `published: true`, the kind
// words of the headings, a case's among them, the heading of the stances the site builds from the
// claim marks (`claims.heading` of the form), the natures of a claim mark
const words = { headings: {}, block_kinds: {}, unit_blocks: {}, unit_fields: {}, natures: {} };
const take = (group, key) => {
  const w = ctx.word(group, key);
  if (w) words[group][key] = w;
};
(function walk(node) {
  if (Array.isArray(node)) { node.forEach(walk); return; }
  if (!node || typeof node !== 'object') return;
  if (pub(node)) {
    if (typeof node.heading === 'string') take('headings', node.heading);
    for (const k of ['kind', 'annex_kind', 'unit_kind']) if (typeof node[k] === 'string') take('block_kinds', node[k]);
    if (typeof node.block === 'string') {
      if (node.labelled) take('unit_blocks', node.block);
      for (const f of node.fields || []) take('unit_fields', f);
      for (const f of (node.misconceptions && node.misconceptions.parts) || []) take('unit_fields', f);
      if (node.cases && typeof node.cases.kind === 'string') take('block_kinds', node.cases.kind);
    }
  }
  for (const v of Object.values(node)) if (v && typeof v === 'object') walk(v);
})(form);
if (typeof cf.separator === 'string') take('block_kinds', cf.separator);
if (form.claims && typeof form.claims.heading === 'string') take('headings', form.claims.heading);
for (const k of claims.NATURES) take('natures', k);

// ---- the concept references of the published text (course/refs.js): each distinct reference, as the
// text writes it, with the concepts it names, so that the engine links them without a grammar
const parser = refs.parser(ctx);
const found = new Map();
(function scan(node) {
  if (typeof node === 'string') {
    if (!parser) return;
    for (const r of parser(node)) {
      const at = node.slice(r.index, node.indexOf(r.list, r.index + r.word.length) + r.list.length);
      if (found.has(at)) continue;
      found.set(at, {
        text: at,
        targets: r.ids.map((id) => {
          const c = refs.conceptOf(ctx, id, r.annex);
          return { id, concept: c ? c.number : null, path: c ? conceptPath(c) : null, anchor: c && c.subs.some((s) => s.id === id) ? id : null };
        }),
      });
    }
  } else if (Array.isArray(node)) node.forEach(scan);
  else if (node && typeof node === 'object') for (const [k, v] of Object.entries(node)) if (k !== 'svg' && k !== 'claim_marks') scan(v);
})({ plan, domains, concepts, storyline, courseGlossary });

const doc = {
  spec: SPEC,
  language: LANGUAGE,
  course: { id: cy.id, title: cy.title, subtitle: cy.subtitle, logo, accent_color: accentColor, annexes: (cy.annexes || []).map(normNumber) },
  plan,
  domains,
  concepts,
  storyline,
  glossary: courseGlossary,
  ...(release !== undefined ? { release } : {}),
  ...(sources !== undefined ? { sources } : {}),
  concept_refs: [...found.values()],
  words: { course: words, site: siteLexicon },
  url_scheme: urlScheme,
};
process.stdout.write(JSON.stringify(doc, null, 2) + '\n');
