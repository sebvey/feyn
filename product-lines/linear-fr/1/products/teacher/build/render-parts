#!/usr/bin/env node
'use strict';
// render-parts <course-dir> [--site-url <base>] [--channel <c>]
// The half of a teacher build that depends on this spec MAJOR: it renders the five parts of
// products/teacher/composition.yaml as text for a course and prints them to stdout as one JSON document,
// whose shape parts.schema.yaml fixes and README.md (this folder) describes. It reads the protocol
// (products/teacher/rules.yaml, the rules by family and group with their purpose), the composition, the two
// lexicons, the learner templates and the course, and fills every {group.key}, {course.<name>} and {classroom.<name>}. It names no
// mechanism of a target: what each part becomes in a classroom is the teacher build's, at the
// root of the repository. Writes nothing. Exit 0 rendered, 1 an input it cannot read (a
// placeholder in neither lexicon, a moment naming an unknown rule), 2 a usage error.
const fs = require('fs');
const path = require('path');
const { createRequire } = require('module');

// here is product-lines/<name>/<MAJOR>/products/teacher/build
const MAJOR = path.resolve(__dirname, '..', '..', '..');
const REPO = path.resolve(MAJOR, '..', '..', '..');
const UNPUBLISHED = '(site non publié)';
const PARTS = ['permanent', 'on-demand', 'course-reads', 'learner-memory', 'permissions'];

function usage(code) {
  const out = code ? console.error : console.log;
  out('usage: render-parts <course-dir> [--site-url <base>] [--channel <c>]');
  out('prints the five parts of products/teacher/composition.yaml rendered for <course-dir>, as JSON (README.md);');
  out('without --site-url the site addresses are « (site non publié) »; --channel defaults to next');
  process.exit(code);
}
function fail(message) {
  console.error(`render-parts: ${message}`);
  process.exit(1);
}

// ---- arguments
let courseDir = null;
let siteUrl = null;
let channel = 'next';
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  const value = () => {
    if (i + 1 >= argv.length) { console.error(`render-parts: ${a} needs a value`); usage(2); }
    return argv[++i];
  };
  if (a === '--help' || a === '-h') usage(0);
  else if (a === '--site-url') siteUrl = value();
  else if (a === '--channel') channel = value();
  else if (a.startsWith('-')) { console.error(`render-parts: unknown option ${a}`); usage(2); }
  else if (courseDir === null) courseDir = a;
  else { console.error(`render-parts: one course folder only (got ${courseDir} and ${a})`); usage(2); }
}
if (courseDir === null) usage(2);
if (!channel) usage(2);
courseDir = path.resolve(courseDir);

const rel = (p) => path.relative(process.cwd(), p) || p;
const read = (p) => {
  try { return fs.readFileSync(p, 'utf8'); } catch (e) { return fail(`cannot read ${rel(p)}`); }
};

// ---- the spec directives this MAJOR follows (spec.yaml, `directives: <MAJOR>`): their lib and package
const specYaml = read(path.join(MAJOR, 'spec.yaml'));
const lineOf = (key) => {
  const l = specYaml.split('\n').find((x) => new RegExp(`^${key}\\s*:`).test(x));
  return l && l.replace(new RegExp(`^${key}\\s*:\\s*`), '').replace(/\s+#.*$/, '').trim().replace(/^(['"])(.*)\1$/, '$2');
};
const directives = lineOf('directives');
if (!/^\d+$/.test(directives || '')) fail(`${rel(MAJOR)}/spec.yaml declares no directives MAJOR`);
const DIRECTIVES = path.join(REPO, 'spec-directives', directives);
if (!fs.existsSync(path.join(DIRECTIVES, 'package.json'))) fail(`no spec directives at ${rel(DIRECTIVES)}`);
const req = createRequire(path.join(DIRECTIVES, 'package.json'));
req('./lib/deps').need();
const yaml = req('./lib/yaml-lines');
const SPEC = `${lineOf('name')}@${lineOf('major')}`;

const parseYaml = (p) => {
  try { return yaml.parse(read(p)); } catch (e) { return fail(`${rel(p)}: ${e.message}`); }
};
const course = parseYaml(path.join(courseDir, 'course.yaml'));
const composition = parseYaml(path.join(MAJOR, 'products', 'teacher', 'composition.yaml'));
const lexicons = [parseYaml(path.join(MAJOR, 'products', 'teacher', 'lexicon.yaml')), parseYaml(path.join(MAJOR, 'course', 'lexicon.yaml'))];
const LEARNER_TEMPLATES = path.join(MAJOR, 'products', 'teacher', 'templates', 'learner');
if (typeof course.id !== 'string' || !course.id) fail('course.yaml has no id');
if (course.spec !== SPEC) fail(`${rel(courseDir)}/course.yaml declares spec ${course.spec}, not ${SPEC}`);
const parts = new Map((composition.parts || []).map((p) => [p.id, p]));
for (const id of PARTS) if (!parts.has(id)) fail(`composition.yaml has no part ${id}`);

// ---- the course parameters (course.yaml) and the classroom parameters
let site = null;
if (siteUrl) site = siteUrl.endsWith('/') ? siteUrl : siteUrl + '/';
const PARAMS = {
  course: {
    id: course.id,
    title: course.title,
    domain_count: String((course.domains || []).length),
    storyline: course.storyline,
    glossary: course.glossary,
  },
  classroom: {
    ...(site
      ? { site_url: site, domains_url: `${site}domaines/`, domain_url: `${site}domaines/{n}/`, concept_url: `${site}concepts/{nn}/` }
      : { site_url: UNPUBLISHED, domains_url: UNPUBLISHED, domain_url: UNPUBLISHED, concept_url: UNPUBLISHED }),
    channel,
  },
};

// a placeholder {group.key}: a course or classroom parameter, or a key of one of the two lexicons;
// a list value is its items in « », separated by commas, and replaces the « » around the
// placeholder when there are some
const quote = (v) => `« ${v} »`;
function valueOf(group, key, where) {
  if (group === 'course' || group === 'classroom') {
    const v = PARAMS[group][key];
    if (typeof v !== 'string' || !v) fail(`${where}: {${group}.${key}} is not a ${group} parameter`);
    return v;
  }
  for (const lex of lexicons) {
    if (lex[group] && Object.prototype.hasOwnProperty.call(lex[group], key)) return lex[group][key];
  }
  return fail(`${where}: {${group}.${key}} is in neither lexicon`);
}
// the filling keeps the sentence whole: a phrase in « » that ends with its own period is not
// followed by the period the rule adds after the »; a value already in parentheses, inside the
// parentheses of a link, keeps one pair
const ENDS_SENTENCE = /\.$/;
function fill(text, where) {
  return text
    .replace(/« \{([a-z_]+)\.([a-z_]+)\} »(\.?)/g, (m, g, k, dot) => {
      const v = valueOf(g, k, where);
      const last = String(Array.isArray(v) ? v[v.length - 1] : v);
      const filled = Array.isArray(v) ? v.map(quote).join(', ') : quote(v);
      return filled + (dot && ENDS_SENTENCE.test(last) ? '' : dot);
    })
    .replace(/\(\{([a-z_]+)\.([a-z_]+)\}\)/g, (m, g, k) => {
      const v = String(valueOf(g, k, where));
      return /^\(.*\)$/.test(v) ? v : `(${v})`;
    })
    .replace(/\{([a-z_]+)\.([a-z_]+)\}/g, (m, g, k) => {
      const v = valueOf(g, k, where);
      return Array.isArray(v) ? v.map(quote).join(', ') : String(v);
    });
}
// a bare key in a `what` of the composition (`headings.onboarding`): its value in « »
const fillWhat = (what) => what.replace(/\b(headings|case_fields)\.([a-z_]+)\b/g, (m, g, k) => quote(valueOf(g, k, 'composition.yaml')));

// ---- the protocol, products/teacher/rules.yaml, in its order: a family is a group whose id is its
// category, rendered "## <n>. <title>" (n its rank among the families of the file); another group
// belongs to the family of its category, which comes before it, rendered "### <title> (`<id>`)";
// each with its purpose; each rule "**<id>** <text>", its why on a line "*Pourquoi :* <why>"
function parseProtocol(doc) {
  const families = [];
  const byCategory = new Map();
  for (const g of (doc && Array.isArray(doc.groups) ? doc.groups : [])) {
    const where = `products/teacher/rules.yaml: group ${g && g.id}`;
    if (!g || typeof g.id !== 'string' || typeof g.title !== 'string' || typeof g.purpose !== 'string') {
      fail(`${where} lacks an id, a title or a purpose (check-spec says more)`);
    }
    let section;
    if (g.id === g.category) {
      section = { kind: 'family', heading: `## ${families.length + 1}. ${g.title}`, category: g.category, purpose: g.purpose, rules: [], groups: [] };
      families.push(section);
      byCategory.set(g.category, section);
    } else {
      const family = byCategory.get(g.category);
      if (!family) fail(`${where}: no family of category ${g.category} before it (check-spec says more)`);
      section = { kind: 'group', id: g.id, heading: `### ${g.title} (\`${g.id}\`)`, purpose: g.purpose, rules: [], family };
      family.groups.push(section);
    }
    for (const r of (Array.isArray(g.rules) ? g.rules : [])) {
      const text = `**${r.id}** ${r.text}` + (r.why ? `\n*Pourquoi :* ${r.why}` : '');
      section.rules.push({ slug: r.id, text, section });
    }
  }
  return { families, byCategory };
}
const { families, byCategory: familyByCategory } = parseProtocol(parseYaml(path.join(MAJOR, 'products', 'teacher', 'rules.yaml')));
if (!families.length) fail(`${rel(MAJOR)}/teacher/rules.yaml holds no rule family`);
const allRules = families.flatMap((f) => [...f.rules, ...f.groups.flatMap((g) => g.rules)]);
const ruleBySlug = new Map(allRules.map((r) => [r.slug, r]));
const groupById = new Map(families.flatMap((f) => f.groups).map((g) => [g.id, g]));

// ---- the moments: a moment's rules name a group by its id, a family by its category, or rules
const moments = (parts.get('on-demand').moments || []).map((m) => {
  const units = (m.rules || []).map((name) => {
    if (groupById.has(name)) return { kind: 'group', group: groupById.get(name) };
    if (familyByCategory.has(name)) return { kind: 'family', family: familyByCategory.get(name) };
    if (ruleBySlug.has(name)) return { kind: 'rule', rule: ruleBySlug.get(name) };
    return fail(`composition.yaml: moment ${m.id} names ${name}, neither a group, a family nor a rule of the protocol`);
  });
  const slugs = new Set();
  for (const u of units) {
    if (u.kind === 'group') u.group.rules.forEach((r) => slugs.add(r.slug));
    if (u.kind === 'family') [...u.family.rules, ...u.family.groups.flatMap((g) => g.rules)].forEach((r) => slugs.add(r.slug));
    if (u.kind === 'rule') slugs.add(u.rule.slug);
  }
  return { ...m, units, slugs };
});
const onDemand = new Set(moments.flatMap((m) => [...m.slugs]));

const ruleText = (r) => fill(r.text, `rule ${r.slug}`);
const purposeText = (s) => fill(s.purpose, s.heading);
const blocks = (list) => list.filter(Boolean).join('\n\n');

// the permanent protocol: every rule no moment loads, in the order of products/teacher/rules.yaml, each
// family and group with a rule left preceded by its heading and its purpose
function permanentProtocol() {
  const out = [];
  for (const f of families) {
    const own = f.rules.filter((r) => !onDemand.has(r.slug));
    const groups = f.groups.map((g) => ({ g, rules: g.rules.filter((r) => !onDemand.has(r.slug)) })).filter((x) => x.rules.length);
    if (!own.length && !groups.length) continue;
    out.push(blocks([f.heading, purposeText(f), ...own.map(ruleText)]));
    for (const { g, rules } of groups) out.push(blocks([g.heading, purposeText(g), ...rules.map(ruleText)]));
  }
  return out.join('\n\n');
}

// the rules of a moment, as a text of their own: a group under its heading raised to ##, a family
// with its groups, rules under the heading of their family or group
function momentRules(m) {
  const body = [];
  for (const u of m.units) {
    if (u.kind === 'group') body.push(blocks([u.group.heading.replace(/^###/, '##'), purposeText(u.group), ...u.group.rules.map(ruleText)]));
    if (u.kind === 'family') {
      const f = u.family;
      body.push(blocks([f.heading, purposeText(f), ...f.rules.map(ruleText)]));
      for (const g of f.groups) body.push(blocks([g.heading, purposeText(g), ...g.rules.map(ruleText)]));
    }
    if (u.kind === 'rule') {
      const s = u.rule.section;
      const heading = s.kind === 'group' ? s.heading.replace(/^###/, '##') : s.heading;
      const prev = body.length && body[body.length - 1].startsWith(heading + '\n') ? body.pop() : heading;
      body.push(blocks([prev, ruleText(u.rule)]));
    }
  }
  return body.join('\n\n');
}

// ---- the course: posture, map, files
const lex = (group, key) => valueOf(group, key, 'render-parts');
const slot = (pattern, values) => pattern.replace(/\{([a-z]+)\}/g, (m, k) => (k in values ? String(values[k]) : m));
function posture() {
  const plan = read(path.join(courseDir, 'plan.md')).split('\n');
  const heading = `## ${lex('headings', 'onboarding')}`;
  const at = plan.findIndex((l) => l.trim() === heading);
  if (at < 0) fail(`plan.md has no heading « ${heading} »`);
  const para = [];
  for (const l of plan.slice(at + 1)) {
    if (l.trim() === '' && para.length) break;
    if (l.trim() === '') continue;
    if (/^(#|\d+\.\s|[-*]\s)/.test(l)) break;
    para.push(l);
  }
  if (!para.length) fail(`plan.md has no posture paragraph under « ${heading} »`);
  return para.join('\n');
}
const concepts = new Map((course.concepts || []).map((c) => [String(c.number), c]));
const conceptTitle = (c) => slot(lex('phrases', 'concept_title'), { n: c.number, title: c.title });
const domainTitle = (d) => slot(lex('phrases', 'domain_title'), { n: d.number, title: d.title });
function courseMap() {
  return (course.domains || []).map((d) => [
    `- ${domainTitle(d)}`,
    ...(d.concepts || []).map((n) => {
      const c = concepts.get(String(n));
      if (!c) fail(`course.yaml: domain ${d.number} names concept ${n}, which is not in concepts`);
      return `  - ${conceptTitle(c)} (\`${c.dir}\`)`;
    }),
  ].join('\n')).join('\n');
}
function courseFiles() {
  return [
    '- `course/course.yaml`: the course map in full (prerequisites, sub-concepts)',
    '- `course/plan.md`: the posture, the target audience, the onboarding questions and the stances',
    `- \`course/${course.storyline}\`: the storyline`,
    `- \`course/${course.glossary}\`: the glossary, one term per notion`,
    ...(course.domains || []).map((d) => `- \`course/${d.file}\`: the domain file of ${domainTitle(d)}`),
    ...(course.concepts || []).map((c) => `- \`course/${c.dir}/\`: ${conceptTitle(c)}, \`concept.md\` (the matter), \`teaching.md\` (the method), \`sources.md\` (the sources)`),
  ].join('\n');
}

// ---- what a moment reads: its draws from the course and from learner memory, as paths in the
// classroom (the course is copied into course/, learner memory is learner/: composition.yaml)
const SLOTS = {
  '<dir>': 'the `dir` of the concept at hand in `course/course.yaml`',
  '<file>': 'the `file` of the domain at hand in `course/course.yaml`',
};
// A draw from a course file with no slot whose `what` names a heading (`headings.onboarding`) is
// rendered with the section under that heading, `text`, so that the moment needs no read: the
// onboarding questions of plan.md reach the onboarding with no tool call before its first message
// (rule first-message-without-tools; a finding of the fresh test onboarding, #507).
function section(file, heading) {
  const lines = read(file).split('\n');
  const at = lines.findIndex((l) => l.trim() === `## ${heading}`);
  if (at < 0) fail(`${path.basename(file)} has no heading « ## ${heading} »`);
  const body = [];
  for (const l of lines.slice(at + 1)) {
    if (/^#{1,2} /.test(l)) break;
    body.push(l);
  }
  return body.join('\n').trim();
}
function draws(list) {
  return (list || []).map((d) => {
    const source = fill(d.source, 'composition.yaml');
    const where = d.from === 'course' ? `course/${source}` : d.from === 'learner' ? `learner/${source}` : null;
    if (!where) return null;
    const out = { path: where, what: fillWhat(d.what) };
    const heading = /\bheadings\.([a-z_]+)\b/.exec(d.what);
    if (d.from === 'course' && heading && !/[<{]/.test(source)) out.text = section(path.join(courseDir, source), lex('headings', heading[1]));
    return out;
  }).filter(Boolean);
}

// ---- the permissions: the classroom draws of the part, « peut s'écrire » (may be written, « se
// commite »: committed, « ne se pousse jamais »: never pushed) or « en lecture seule » (read only);
// the `what` texts are French (decision language-policy)
const permissions = { writable: [], read_only: [], commit: false, push: false };
for (const d of parts.get('permissions').draws || []) {
  if (d.from !== 'classroom') continue;
  if (/^peut s'écrire/.test(d.what)) {
    permissions.writable.push(d.source);
    if (/se commite/.test(d.what)) permissions.commit = true;
    if (/se pousse/.test(d.what) && !/ne se pousse jamais/.test(d.what)) permissions.push = true;
  } else if (/^en lecture seule/.test(d.what)) permissions.read_only.push(d.source);
  else fail(`composition.yaml: permissions: ${d.source} is neither « peut s'écrire » nor « en lecture seule »`);
}

// ---- the parts
const learnerTemplates = fs.readdirSync(LEARNER_TEMPLATES).filter((x) => x.endsWith('.md')).sort()
  .map((name) => ({ name, text: read(path.join(LEARNER_TEMPLATES, name)) }));
const rendered = {
  spec: SPEC,
  permanent: {
    protocol: permanentProtocol(),
    posture: posture(),
    course_map: courseMap(),
    course_files: courseFiles(),
  },
  moments: moments.map((m) => {
    const reads = draws(m.draws);
    return {
      id: m.id,
      when: m.when,
      draws: reads,
      slots: Object.keys(SLOTS).filter((s) => reads.some((r) => r.path.includes(s))).map((s) => ({ slot: s, meaning: SLOTS[s] })),
      rules: momentRules(m),
    };
  }),
  learner_templates: learnerTemplates,
  permissions,
  params: PARAMS,
};
process.stdout.write(JSON.stringify(rendered, null, 2) + '\n');
