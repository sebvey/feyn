#!/usr/bin/env node
'use strict';
// Runs check-course on the fixtures, once each with the default (every check of method test), and
// says whether every run gave the expected result (a real course is checked by
// product-lines/check-course courses/<id>, not here; the tests of the spec's own files, check-spec,
// are tested by spec-directives/<MAJOR>/tests/test-fixtures). The severity of each check follows
// from its rules (README.md section 3 of this MAJOR): the test reads course/rules.yaml itself, holds
// the checks ./rules.js gives (the module check-course loads) and the exit codes to it.
//   --list                         names every check with its category and
//                                  its severity, as course/rules.yaml gives them; the check it
//                                  does not run (taught-check) marked "not run here"
//   fixtures/valid                 passes every check, and every check of method test runs
//   fixtures/lexicon.yaml          the lexicon of every run (--lexicon), with the values of the
//                                  spec's own course/lexicon.yaml
//   a lexicon that does not exist  fails course-yaml as a tooling error, exit code 1
//   fixtures/broken/<name>/EXPECT  "check: <id>", "message: <fragment>", optional "lexicon: <path>":
//                                  that check fails with a line containing the fragment, no other
//                                  check fails beside it, and the exit code is 1 when it blocks,
//                                  0 when it reports; broken/course-yaml-unlisted-folder passes
//                                  with --concept 0
//   --category                     runs the checks of those categories only; an unknown category
//                                  (the spec's own name among them), --quality and an id
//                                  check-course does not run are usage errors
//   fixtures/dispatcher/<name>     a course.yaml that product-lines/check-course refuses: other-spec
//                                  (spec other@1), unknown-major (linear-fr@9); the
//                                  dispatcher passes --category through
const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');
const directives = require('./directives');

const here = __dirname;
const runner = path.join(here, 'check-course');
const fx = path.join(here, 'fixtures');
// here is product-lines/<name>/<MAJOR>/course/checks; major, the MAJOR's folder
const major = path.resolve(here, '..', '..');
const repo = path.resolve(major, '..', '..', '..');
let bad = 0;

function run(dir, extra) {
  const r = spawnSync(process.execPath, [runner, dir, ...extra], { encoding: 'utf8' });
  return { code: r.status, lines: r.stdout.split('\n').filter(Boolean), err: r.stderr };
}
function report(name, ok, detail) {
  console.log(`${ok ? 'ok  ' : 'FAIL'} ${name}${ok ? '' : ': ' + detail}`);
  if (!ok) bad++;
}
const SUMMARY = 'summary: ';
const checkLines = (r) => r.lines.filter((l) => !l.startsWith(SUMMARY));
const notOk = (r) => checkLines(r).filter((l) => !l.endsWith(': ok')).join(' | ') || r.err;
const failing = (r) => r.lines.filter((l) => l.includes(': fail: '));
const ids = (r) => [...new Set(checkLines(r).map((l) => l.slice(0, l.indexOf(':'))))];

// the severity of each check, read here from course/rules.yaml (README.md section 3 of this
// MAJOR): it blocks when its rules are requirements verified by test, otherwise it reports
const RULED = new Map(); // check -> { category, levels, methods }
{
  const yaml = directives.lib('yaml-lines');
  for (const g of yaml.parse(fs.readFileSync(path.join(major, 'course', 'rules.yaml'), 'utf8')).groups) {
    for (const r of g.rules) {
      if (!r.check) continue;
      const c = RULED.get(r.check) || { category: r.category || g.category, levels: new Set(), methods: new Set() };
      c.levels.add(r.level);
      c.methods.add(r.method || g.method);
      RULED.set(r.check, c);
    }
  }
}
const severityOf = (c) => ([...c.levels].join() === 'requirement' && [...c.methods].join() === 'test' ? 'blocks' : 'reports');

// ./rules.js, the module check-course loads, gives each check of course/rules.yaml the category and
// the severity read above
{
  const loaded = require('./rules').load(here).checks;
  const wrong = loaded.filter((c) => !RULED.has(c.id) || RULED.get(c.id).category !== c.category || severityOf(RULED.get(c.id)) !== c.severity);
  const missing = [...RULED.keys()].filter((id) => !loaded.some((c) => c.id === id));
  report('rules.js gives every check of course/rules.yaml the category and the severity of its rules',
    loaded.length > 0 && !wrong.length && !missing.length, `wrong: ${wrong.map((c) => `${c.id} ${c.category} ${c.severity}`).join(', ') || 'none'}; missing: ${missing.join(', ') || 'none'}`);
}

// --list: every check of course/rules.yaml, its category and its severity as they follow from its
// rules; the checks of method test run here, and the tests of check-spec, which verify no rule,
// are not listed
const LIST = spawnSync(process.execPath, [runner, '--list'], { encoding: 'utf8' }).stdout.split('\n').filter(Boolean)
  .map((l) => { const [id, category, severity, ...rest] = l.split(/\s+/); return { id, category, severity, runsHere: rest.length === 0 }; });
const RUN = LIST.filter((c) => c.runsHere);
const SEVERITY = Object.fromEntries(LIST.map((c) => [c.id, c.severity]));
{
  const wrong = LIST.filter((c) => !RULED.has(c.id) || RULED.get(c.id).category !== c.category || severityOf(RULED.get(c.id)) !== c.severity);
  const missing = [...RULED.keys()].filter((id) => !LIST.some((c) => c.id === id));
  report('--list names every check of course/rules.yaml with the category and the severity of its rules',
    LIST.length > 0 && !wrong.length && !missing.length, `wrong: ${wrong.map((c) => `${c.id} ${c.category} ${c.severity}`).join(', ') || 'none'}; missing: ${missing.join(', ') || 'none'}`);
  const notHere = LIST.filter((c) => !c.runsHere).map((c) => c.id).sort().join(',');
  report('--list marks taught-check "not run here", and no other', notHere === 'taught-check', notHere);
  // the ids of the tests of check-spec, read from its --list, not copied here
  const specTests = spawnSync(process.execPath, [path.join(repo, 'spec-directives', '1', 'tests', 'check-spec'), '--list'], { encoding: 'utf8' })
    .stdout.split('\n').filter(Boolean);
  const spec = LIST.filter((c) => specTests.includes(c.id)).map((c) => c.id);
  report('--list names none of the tests of check-spec', specTests.length > 0 && spec.length === 0,
    `check-spec --list: ${specTests.join(',') || 'nothing'}; named: ${spec.join(',') || 'none'}`);
  report('--list has blocking and reporting checks among those run here',
    RUN.some((c) => c.severity === 'blocks') && RUN.some((c) => c.severity === 'reports'), RUN.map((c) => `${c.id} ${c.severity}`).join(', '));
}
const runIds = (cats) => RUN.filter((c) => !cats || cats.includes(c.category)).map((c) => c.id).join(',');

// valid
{
  const r = run(path.join(fx, 'valid'), ['--lexicon', path.join(fx, 'lexicon.yaml')]);
  report('valid passes every check, and every check --list runs here runs', r.code === 0 && ids(r).join(',') === runIds(), notOk(r) || ids(r).join(','));
  const s = r.lines[r.lines.length - 1] || '';
  report('the run ends with a summary that counts the blocking and the reporting checks',
    s === `${SUMMARY}${RUN.filter((c) => c.severity === 'blocks').length} blocking checks, 0 failed; ${RUN.filter((c) => c.severity === 'reports').length} reporting checks, 0 failed; exit 0`, s);
}

// a lexicon that does not exist fails course-yaml as a tooling error (no rule), exit code 1
{
  const r = run(path.join(fx, 'valid'), ['--lexicon', path.join(fx, 'no-such-lexicon.yaml')]);
  report('a lexicon that does not exist fails course-yaml as a tooling error, exit code 1', r.code === 1 && failing(r).some((l) => l.startsWith('course-yaml: fail: ') && l.includes('tooling error') && l.includes("the spec's lexicon is missing") && l.includes('does not exist') && l.includes('course/README.md section 7')), notOk(r));
}

// broken: one run each, with the default
for (const name of fs.readdirSync(path.join(fx, 'broken')).sort()) {
  const d = path.join(fx, 'broken', name);
  const ex = Object.fromEntries(fs.readFileSync(path.join(d, 'EXPECT'), 'utf8').split('\n').filter(Boolean).map((l) => [l.slice(0, l.indexOf(':')), l.slice(l.indexOf(':') + 1).trim()]));
  const lexicon = ex.lexicon ? path.resolve(d, ex.lexicon) : path.join(fx, 'lexicon.yaml');
  const sev = SEVERITY[ex.check];
  const r = run(d, ['--lexicon', lexicon]);
  const hit = r.lines.filter((l) => l.startsWith(ex.check + ': fail: '));
  const want = sev === 'blocks' ? 1 : 0;
  report(`broken/${name} fails ${ex.check} (${sev}), exit code ${want}`, sev !== undefined && r.code === want && hit.some((l) => l.includes(ex.message)), `expected "${ex.message}" and exit code ${want}, got ${r.code}: ${r.lines.join(' | ') || r.err}`);
  // and only that check: the other checks do not mind the defect
  const others = failing(r).filter((l) => !l.startsWith(ex.check + ': '));
  if (others.length) report(`broken/${name} breaks nothing else`, false, others.slice(0, 2).join(' | '));
}

// --category runs the checks of those categories only, in the order of the default run
{
  const lexicon = ['--lexicon', path.join(fx, 'lexicon.yaml')];
  for (const cats of [['writing'], ['pedagogy'], ['structure', 'diagrams']]) {
    const r = run(path.join(fx, 'valid'), [...lexicon, '--category', cats.join(',')]);
    report(`--category ${cats.join(',')} runs the checks of ${cats.join(', ')} only`, r.code === 0 && ids(r).length > 0 && ids(r).join(',') === runIds(cats), notOk(r) || ids(r).join(','));
  }
  // a blocking failure outside the categories selected is not run: exit code 0
  const b = run(path.join(fx, 'broken', 'drawing-contract'), [...lexicon, '--category', 'writing']);
  report('broken/drawing-contract with --category writing: drawing-contract does not run, exit code 0', b.code === 0 && !ids(b).includes('drawing-contract'), notOk(b));
  const c = run(path.join(fx, 'broken', 'drawing-contract'), [...lexicon, '--category', 'diagrams']);
  report('broken/drawing-contract with --category diagrams: exit code 1', c.code === 1 && failing(c).some((l) => l.startsWith('drawing-contract: fail: ')), notOk(c));
  const l = spawnSync(process.execPath, [runner, '--list', '--category', 'pedagogy'], { encoding: 'utf8' }).stdout.split('\n').filter(Boolean).map((x) => x.split(/\s+/)[0]);
  report('--list --category pedagogy lists the pedagogy checks only', l.join(',') === LIST.filter((x) => x.category === 'pedagogy').map((x) => x.id).join(','), l.join(','));
  const SPEC_NAME = 'spec';
  for (const [what, extra, want] of [
    ['an unknown category', ['--category', 'style'], 'unknown category "style"'],
    // the spec's own files have tests in check-spec, no category (#339); the name is held in a
    // variable so the Done when's rg of #339, which looks for the category in the sources,
    // finds no literal of it here
    ['the name of the spec as a category', ['--category', SPEC_NAME], `unknown category "${SPEC_NAME}"`],
    ['--quality', ['--quality'], '--quality is gone: the reporting checks run by default'],
    ['--only of a test of check-spec', ['--only', 'rule-files'], 'unknown check id "rule-files"'],
    ['--only of lexicon-keys, a test of check-spec', ['--only', 'lexicon-keys'], 'unknown check id "lexicon-keys"'],
    ['--only outside --category', ['--category', 'writing', '--only', 'sources'], '"sources" is in category sources'],
  ]) {
    const r = run(path.join(fx, 'valid'), [...lexicon, ...extra]);
    report(`${what} is a usage error, exit code 2`, r.code === 2 && r.lines.length === 0 && r.err.split('\n').filter(Boolean).length === 1 && r.err.includes(want), `got ${r.code}: ${r.err || r.lines.join(' | ')}`);
  }
}

// the schemas of the spec (course/schemas/*.schema.yaml, JSON Schema 2020-12 read by Ajv2020):
// valid's course.yaml, the frontmatter of each of its concept.md that has one and its sources.yaml
// are valid against them
{
  const Ajv2020 = directives.require('ajv/dist/2020').default;
  const yaml = directives.lib('yaml-lines');
  const md = directives.lib('md');
  const schema = (n) => new Ajv2020({ allErrors: true, logger: false }).compile(yaml.parse(fs.readFileSync(path.join(major, 'course', 'schemas', n), 'utf8')));
  const errs = (v) => v.errors.map((e) => `${e.instancePath || '/'} ${e.message}`).slice(0, 2).join(' | ');
  const course = schema('course.schema.yaml');
  const front = schema('concept-frontmatter.schema.yaml');
  const cy = yaml.parse(fs.readFileSync(path.join(fx, 'valid', 'course.yaml'), 'utf8'));
  report('valid/course.yaml is valid against course/schemas/course.schema.yaml', course(cy), course.errors && errs(course));
  for (const c of cy.concepts) {
    const split = md.split(fs.readFileSync(path.join(fx, 'valid', c.dir, 'concept.md'), 'utf8'));
    if (!split.hasFront) continue;
    report(`valid/${c.dir}/concept.md is valid against course/schemas/concept-frontmatter.schema.yaml`, front(split.data), front.errors && errs(front));
  }
  const sources = schema('sources.schema.yaml');
  const sy = yaml.parse(fs.readFileSync(path.join(fx, 'valid', 'sources.yaml'), 'utf8'));
  report('valid/sources.yaml is valid against course/schemas/sources.schema.yaml', sources(sy), sources.errors && errs(sources));
}

// --concept looks at one concept only: an unlisted concept folder does not fail course-yaml
{
  const r = run(path.join(fx, 'broken', 'course-yaml-unlisted-folder'), ['--lexicon', path.join(fx, 'lexicon.yaml'), '--only', 'course-yaml', '--concept', '0']);
  report('broken/course-yaml-unlisted-folder passes course-yaml with --concept 0', r.code === 0, notOk(r));
}

// the dispatcher (product-lines/check-course): it runs this MAJOR's checks on a course declaring it,
// and refuses an unknown spec or MAJOR, naming it, with exit code 2
{
  const dispatcher = path.join(repo, 'product-lines', 'check-course');
  const disp = (dir, extra) => {
    const r = spawnSync(process.execPath, [dispatcher, dir, ...extra], { encoding: 'utf8' });
    return { code: r.status, lines: r.stdout.split('\n').filter(Boolean), err: r.stderr };
  };
  const v = disp(path.join(fx, 'valid'), ['--lexicon', path.join(fx, 'lexicon.yaml')]);
  report("the dispatcher runs this MAJOR's checks on valid", v.code === 0 && ids(v).join(',') === runIds(), notOk(v) || ids(v).join(','));
  const w = disp(path.join(fx, 'valid'), ['--lexicon', path.join(fx, 'lexicon.yaml'), '--category', 'writing']);
  report('the dispatcher passes --category through', w.code === 0 && ids(w).join(',') === runIds(['writing']), notOk(w) || ids(w).join(','));
  for (const [name, want] of [['other-spec', 'unknown spec "other"'], ['unknown-major', 'unknown MAJOR 9 of spec "linear-fr"']]) {
    const r = disp(path.join(fx, 'dispatcher', name), []);
    report(`the dispatcher refuses dispatcher/${name}`, r.code === 2 && r.err.includes(want) && r.lines.length === 0, `expected exit 2 and "${want}", got ${r.code}: ${r.err || r.lines.join(' | ')}`);
  }
}
console.log(bad ? `${bad} unexpected result(s)` : 'all as expected');
process.exit(bad ? 1 : 0);
