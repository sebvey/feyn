#!/usr/bin/env node
'use strict';
// check-course <course-dir> [<the options of the MAJOR's check-course>]
// Reads `spec: <name>@<MAJOR>` in <course-dir>/course.yaml and runs
// product-lines/<name>/<MAJOR>/course/checks/check-course with the same arguments, its output and
// exit code unchanged. Refuses (exit 2) a course whose spec or MAJOR has no folder here, or whose
// MAJOR's spec.yaml declares no directives MAJOR that has a folder in spec-directives/, and stops
// (exit 2) when the dependencies of those directives are not installed (`npm ci` in
// spec-directives/<MAJOR>/).
// The MAJOR's check-course takes its checks, their category and their severity from its rule
// files (spec-directives/1/README.md section 5); --category and its other options are passed
// through.
const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');
const { createRequire } = require('module');

const SPECS = __dirname;
const VALUED = new Set(['--category', '--only', '--concept', '--lexicon']);

function usage(code) {
  const out = code ? console.error : console.log;
  out('usage: check-course <course-dir> [--category <c>[,<c>...]] [--only <id>[,<id>...]] [--concept <number>] [--lexicon <file>] [--list]');
  out('runs product-lines/<name>/<MAJOR>/course/checks/check-course for the spec that <course-dir>/course.yaml declares,');
  out('with the same arguments: every check of method test, a blocking failure exit 1, a reporting one 0;');
  out('--list needs a course, since the checks depend on its MAJOR');
  process.exit(code);
}
function refuse(message) {
  console.error(`check-course: ${message}`);
  process.exit(2);
}

const args = process.argv.slice(2);
let dir = null;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === '--help' || a === '-h') usage(0);
  else if (VALUED.has(a)) i++;
  else if (!a.startsWith('-') && dir === null) dir = a;
}
if (dir === null) usage(2);

const file = path.join(dir, 'course.yaml');
let text;
try { text = fs.readFileSync(file, 'utf8'); } catch (e) { refuse(`cannot read ${file}`); }

const isDir = (p) => { try { return fs.statSync(p).isDirectory(); } catch (e) { return false; } };
const known = (p) => fs.readdirSync(p).filter((d) => !d.startsWith('.') && isDir(path.join(p, d))).sort();
// spec "<name>@<MAJOR>" -> the MAJOR's check-course, or a refusal
function runnerOf(spec) {
  const m = /^([a-z0-9]+(?:-[a-z0-9]+)*)@(\d+)$/.exec(spec);
  if (!m) refuse(`${file}: spec "${spec}" must be <name>@<MAJOR>`);
  const [, name, major] = m;
  if (!isDir(path.join(SPECS, name))) refuse(`unknown spec "${name}" in ${file} (known: ${known(SPECS).join(', ')})`);
  const runner = path.join(SPECS, name, major, 'course', 'checks', 'check-course');
  if (!fs.existsSync(runner)) {
    const majors = known(path.join(SPECS, name)).filter((d) => /^\d+$/.test(d));
    refuse(`unknown MAJOR ${major} of spec "${name}" in ${file} (known: ${majors.join(', ') || 'none'})`);
  }
  return runner;
}
// a spec MAJOR's folder -> the folder of the package of the directives MAJOR its spec.yaml
// declares (spec-directives/<MAJOR>/), found by a line scan of its "directives:" line, or a refusal
function directivesOf(major) {
  const declaration = path.join(major, 'spec.yaml');
  let t;
  try { t = fs.readFileSync(declaration, 'utf8'); } catch (e) { refuse(`cannot read ${declaration}`); }
  const l = t.split('\n').find((x) => /^directives\s*:/.test(x));
  const d = l && l.replace(/^directives\s*:\s*/, '').replace(/\s+#.*$/, '').trim().replace(/^(['"])(.*)\1$/, '$2');
  if (!l || !/^\d+$/.test(d)) refuse(`${declaration} declares no directives MAJOR (directives: <MAJOR>)`);
  const pkg = path.join(SPECS, '..', 'spec-directives', d);
  if (!fs.existsSync(path.join(pkg, 'package.json'))) {
    const all = path.join(SPECS, '..', 'spec-directives');
    const majors = (isDir(all) ? known(all) : []).filter((x) => /^\d+$/.test(x));
    refuse(`unknown directives MAJOR ${d} in ${declaration} (known: ${majors.join(', ') || 'none'})`);
  }
  return pkg;
}

// The YAML reader is the `yaml` package of the directives MAJOR that the spec MAJOR declares in
// its spec.yaml (decision `checks-use-ajv-and-yaml`), so the top-level "spec:" line names the
// MAJOR whose directives' package then reads course.yaml (YAML 1.2); a
// `spec` read otherwise names the MAJOR run. A course.yaml with a YAML error runs the MAJOR of
// its "spec:" line, whose course-yaml check reports the error. The line scan is the bootstrap: a
// spec it misses (a quoted key, a value on the next line) is refused as "declares no spec", even
// when YAML would read it. The dispatcher checks only the `yaml` dependency it needs; the MAJOR's
// check-course checks the others.
const line = text.split('\n').find((l) => /^spec\s*:/.test(l));
if (!line) refuse(`${file} declares no spec (spec: <name>@<MAJOR>)`);
const spec = line.replace(/^spec\s*:\s*/, '').replace(/\s+#.*$/, '').trim().replace(/^(['"])(.*)\1$/, '$2');
let runner = runnerOf(spec);
const pkg = directivesOf(path.resolve(path.dirname(runner), '..', '..'));
if (!fs.existsSync(path.join(pkg, 'node_modules', 'yaml', 'package.json'))) {
  console.error(`checks: dependencies missing, run: mise exec -- npm ci --prefix ${path.relative(process.cwd(), pkg) || '.'}`);
  process.exit(2);
}
const YAML = createRequire(path.join(pkg, 'package.json'))('yaml');
const doc = YAML.parseDocument(text, { version: '1.2' });
const declared = doc.errors.length ? null : doc.get('spec');
if (typeof declared === 'string' && declared !== spec) runner = runnerOf(declared);

const r = spawnSync(process.execPath, [runner, ...args], { stdio: 'inherit' });
if (r.error) refuse(`cannot run ${runner}: ${r.error.message}`);
process.exit(r.status === null ? 1 : r.status);
