#!/usr/bin/env node
'use strict';
// check-course <course-dir> [--quality] [--only <id>[,<id>...]] [--concept <number>] [--lang-dir <dir>] [--list]
// Two modes (decision `versioned-objects-and-spec-layout`): the conformity checks by default, the
// quality checks with --quality. No conformity path runs the quality mode.
const path = require('path');
require('./lib/deps').need();
const { load } = require('./lib/course');

const MODES = {
  conformity: ['course-yaml', 'concept-folder', 'conventions', 'svg-contract', 'sources', 'course-files',
    'domain-first-sentence', 'language-pack-keys'],
  quality: ['glossary-order', 'typography', 'domain-first-sentence-standalone'],
};

function usage(code) {
  const out = code ? console.error : console.log;
  out('usage: check-course <course-dir> [--quality] [--only <id>[,<id>...]] [--concept <number>] [--lang-dir <dir>]');
  out('       check-course [--quality] --list');
  out(`conformity checks (the default): ${MODES.conformity.join(', ')}`);
  out(`quality checks (--quality): ${MODES.quality.join(', ')}`);
  process.exit(code);
}

const args = process.argv.slice(2);
let dir = null;
const only = [];
const opts = {};
let mode = 'conformity';
let list = false;
for (let i = 0; i < args.length; i++) {
  const a = args[i];
  if (a === '--help' || a === '-h') usage(0);
  else if (a === '--list') list = true;
  else if (a === '--quality') mode = 'quality';
  else if (a === '--only') only.push(...String(args[++i] || '').split(',').filter(Boolean));
  else if (a.startsWith('--only=')) only.push(...a.slice(7).split(',').filter(Boolean));
  else if (a === '--concept') opts.concept = args[++i];
  else if (a.startsWith('--concept=')) opts.concept = a.slice(10);
  else if (a === '--lang-dir') opts.langDir = path.resolve(args[++i] || '');
  else if (a.startsWith('--lang-dir=')) opts.langDir = path.resolve(a.slice(11));
  else if (a.startsWith('-')) { console.error(`unknown option ${a}`); usage(2); }
  else if (dir === null) dir = a;
  else usage(2);
}
const CHECKS = MODES[mode];
if (list) { console.log(CHECKS.join('\n')); process.exit(0); }
if (dir === null) usage(2);
for (const id of only) {
  if (CHECKS.includes(id)) continue;
  const other = mode === 'quality' ? 'conformity' : 'quality';
  if (MODES[other].includes(id)) console.error(`"${id}" is a ${other} check: ${other === 'quality' ? 'add' : 'drop'} --quality`);
  else console.error(`unknown check id "${id}" (${mode} checks: ${CHECKS.join(', ')})`);
  process.exit(2);
}

const fs = require('fs');
if (!fs.existsSync(dir) || !fs.statSync(dir).isDirectory()) { console.error(`not a directory: ${dir}`); process.exit(2); }

const ctx = load(dir, opts);
const run = only.length ? CHECKS.filter((id) => only.includes(id)) : CHECKS;
let failed = 0;
for (const id of run) {
  let failures;
  try {
    failures = require('./' + id).run(ctx);
  } catch (e) {
    failures = [{ file: 'check-course', line: 1, message: `the check crashed: ${e.stack.split('\n').slice(0, 3).join(' | ')}` }];
  }
  if (!failures.length) console.log(`${id}: ok`);
  else {
    failed++;
    for (const f of failures) console.log(`${id}: fail: ${f.file}:${f.line} ${f.message}`);
  }
}
process.exit(failed ? 1 : 0);
