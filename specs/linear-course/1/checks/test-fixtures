#!/usr/bin/env node
'use strict';
// Runs check-course on the fixtures, once each with the default (every check of method test),
// and says whether every run gave the expected result (a real course is checked by
// specs/check-course courses/<id>, not here). The severity of each check follows from its rules
// (SPEC.md section 7): the test reads the rule files itself and holds the exit codes to it.
//   --list                         names every check of the rule files with its category and
//                                  its severity, as the rule files give them; the checks it does
//                                  not run (check-spec's, taught-check) marked "not run here"
//   fixtures/valid                 passes every check, and every check of method test runs
//   fixtures/lang-no-anaphora      a pack without checks.anaphora: domain-first-sentence-standalone
//                                  (reports) fails alone, exit code 0
//   fixtures/broken/<name>/EXPECT  "check: <id>", "message: <fragment>", optional "lang-dir: <path>":
//                                  that check fails with a line containing the fragment, no other
//                                  check fails beside it, and the exit code is 1 when it blocks,
//                                  0 when it reports; broken/course-yaml-unlisted-folder passes
//                                  with --concept 0
//   --category                     runs the checks of those categories only; an unknown category,
//                                  --quality and an id check-course does not run are usage errors
//   fixtures/spec/...              the same for check-spec (the spec's own files), and the
//                                  repository's spec passes it
//   fixtures/dispatcher/<name>     a course.yaml that specs/check-course refuses: other-spec
//                                  (spec other@1), unknown-major (linear-course@9); the
//                                  dispatcher passes --category through
const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');
require('./lib/deps').need();

const here = __dirname;
const runner = path.join(here, 'check-course');
const fx = path.join(here, 'fixtures');
// here is specs/<name>/<MAJOR>/checks
const repo = path.resolve(here, '..', '..', '..', '..');
let bad = 0;

function run(dir, extra) {
  const r = spawnSync(process.execPath, [runner, dir, ...extra], { encoding: 'utf8' });
  return { code: r.status, lines: r.stdout.split('\n').filter(Boolean), err: r.stderr };
}
function report(name, ok, detail) {
  console.log(`${ok ? 'ok  ' : 'FAIL'} ${name}${ok ? '' : ': ' + detail}`);
  if (!ok) bad++;
}
const SUMMARY = 'summary: ';
const checkLines = (r) => r.lines.filter((l) => !l.startsWith(SUMMARY));
const notOk = (r) => checkLines(r).filter((l) => !l.endsWith(': ok')).join(' | ') || r.err;
const failing = (r) => r.lines.filter((l) => l.includes(': fail: '));
const ids = (r) => [...new Set(checkLines(r).map((l) => l.slice(0, l.indexOf(':'))))];

// the severity of each check, read here from the rule files (SPEC.md section 7): it blocks when
// its rules are requirements verified by test, otherwise it reports
const RULED = new Map(); // check -> { category, levels, methods }
{
  const yaml = require('./lib/yaml-lines');
  for (const file of ['rules/course.yaml', 'rules/spec.yaml']) {
    for (const g of yaml.parse(fs.readFileSync(path.join(here, '..', file), 'utf8')).groups) {
      for (const r of g.rules) {
        if (!r.check) continue;
        const c = RULED.get(r.check) || { category: r.category || g.category, levels: new Set(), methods: new Set() };
        c.levels.add(r.level);
        c.methods.add(r.method || g.method);
        RULED.set(r.check, c);
      }
    }
  }
}
const severityOf = (c) => ([...c.levels].join() === 'requirement' && [...c.methods].join() === 'test' ? 'blocks' : 'reports');

// --list: every check of the rule files, its category and its severity as they follow from its
// rules; the checks of method test run here, but check-spec's
const LIST = spawnSync(process.execPath, [runner, '--list'], { encoding: 'utf8' }).stdout.split('\n').filter(Boolean)
  .map((l) => { const [id, category, severity, ...rest] = l.split(/\s+/); return { id, category, severity, runsHere: rest.length === 0 }; });
const RUN = LIST.filter((c) => c.runsHere);
const SEVERITY = Object.fromEntries(LIST.map((c) => [c.id, c.severity]));
{
  const wrong = LIST.filter((c) => !RULED.has(c.id) || RULED.get(c.id).category !== c.category || severityOf(RULED.get(c.id)) !== c.severity);
  const missing = [...RULED.keys()].filter((id) => !LIST.some((c) => c.id === id));
  report('--list names every check of the rule files with the category and the severity of its rules',
    LIST.length > 0 && !wrong.length && !missing.length, `wrong: ${wrong.map((c) => `${c.id} ${c.category} ${c.severity}`).join(', ') || 'none'}; missing: ${missing.join(', ') || 'none'}`);
  const notHere = LIST.filter((c) => !c.runsHere).map((c) => c.id).sort().join(',');
  report('--list marks rule-files, rule-slugs and taught-check "not run here", and no other', notHere === 'rule-files,rule-slugs,taught-check', notHere);
  report('--list has blocking and reporting checks among those run here',
    RUN.some((c) => c.severity === 'blocks') && RUN.some((c) => c.severity === 'reports'), RUN.map((c) => `${c.id} ${c.severity}`).join(', '));
}
const runIds = (cats) => RUN.filter((c) => !cats || cats.includes(c.category)).map((c) => c.id).join(',');

// valid
{
  const r = run(path.join(fx, 'valid'), ['--lang-dir', path.join(fx, 'lang')]);
  report('valid passes every check, and every check --list runs here runs', r.code === 0 && ids(r).join(',') === runIds(), notOk(r) || ids(r).join(','));
  const s = r.lines[r.lines.length - 1] || '';
  report('the run ends with a summary that counts the blocking and the reporting checks',
    s === `${SUMMARY}${RUN.filter((c) => c.severity === 'blocks').length} blocking checks, 0 failed; ${RUN.filter((c) => c.severity === 'reports').length} reporting checks, 0 failed; exit 0`, s);
}

// a reporting failure alone: a pack without checks.anaphora is consumable; the reporting
// domain-first-sentence-standalone says so, and the exit code stays 0
{
  const lang = path.join(fx, 'lang-no-anaphora');
  const r = run(path.join(fx, 'valid'), ['--lang-dir', lang]);
  const f = failing(r);
  report('lang-no-anaphora fails domain-first-sentence-standalone (reports) alone, exit code 0',
    SEVERITY['domain-first-sentence-standalone'] === 'reports' && r.code === 0 && f.length === 1 && f[0].startsWith('domain-first-sentence-standalone: fail: ') && f[0].includes('no checks.anaphora')
      && r.lines[r.lines.length - 1].includes('1 failed (domain-first-sentence-standalone); exit 0'), notOk(r));
  // a blocking failure beside a reporting one: exit code 1
  const b = run(path.join(fx, 'broken', 'course-files'), ['--lang-dir', lang]);
  report('broken/course-files with lang-no-anaphora: a blocking and a reporting failure, exit code 1',
    b.code === 1 && failing(b).some((l) => l.startsWith('course-files: fail: ')) && failing(b).some((l) => l.startsWith('domain-first-sentence-standalone: fail: ')), notOk(b));
}

// broken: one run each, with the default
for (const name of fs.readdirSync(path.join(fx, 'broken')).sort()) {
  const d = path.join(fx, 'broken', name);
  const ex = Object.fromEntries(fs.readFileSync(path.join(d, 'EXPECT'), 'utf8').split('\n').filter(Boolean).map((l) => [l.slice(0, l.indexOf(':')), l.slice(l.indexOf(':') + 1).trim()]));
  const lang = ex['lang-dir'] ? path.resolve(d, ex['lang-dir']) : path.join(fx, 'lang');
  const sev = SEVERITY[ex.check];
  const r = run(d, ['--lang-dir', lang]);
  const hit = r.lines.filter((l) => l.startsWith(ex.check + ': fail: '));
  const want = sev === 'blocks' ? 1 : 0;
  report(`broken/${name} fails ${ex.check} (${sev}), exit code ${want}`, sev !== undefined && r.code === want && hit.some((l) => l.includes(ex.message)), `expected "${ex.message}" and exit code ${want}, got ${r.code}: ${r.lines.join(' | ') || r.err}`);
  // and only that check: the other checks do not mind the defect (a broken pack excepted)
  const others = ex.check === 'language-pack-keys' ? [] : failing(r).filter((l) => !l.startsWith(ex.check + ': '));
  if (others.length) report(`broken/${name} breaks nothing else`, false, others.slice(0, 2).join(' | '));
}

// --category runs the checks of those categories only, in the order of the default run
{
  const lang = ['--lang-dir', path.join(fx, 'lang')];
  for (const cats of [['writing'], ['spec'], ['structure', 'diagrams']]) {
    const r = run(path.join(fx, 'valid'), [...lang, '--category', cats.join(',')]);
    report(`--category ${cats.join(',')} runs the checks of ${cats.join(', ')} only`, r.code === 0 && ids(r).length > 0 && ids(r).join(',') === runIds(cats), notOk(r) || ids(r).join(','));
  }
  // a blocking failure outside the categories selected is not run: exit code 0
  const b = run(path.join(fx, 'broken', 'svg-contract'), [...lang, '--category', 'writing']);
  report('broken/svg-contract with --category writing: svg-contract does not run, exit code 0', b.code === 0 && !ids(b).includes('svg-contract'), notOk(b));
  const c = run(path.join(fx, 'broken', 'svg-contract'), [...lang, '--category', 'diagrams']);
  report('broken/svg-contract with --category diagrams: exit code 1', c.code === 1 && failing(c).some((l) => l.startsWith('svg-contract: fail: ')), notOk(c));
  const l = spawnSync(process.execPath, [runner, '--list', '--category', 'pedagogy'], { encoding: 'utf8' }).stdout.split('\n').filter(Boolean).map((x) => x.split(/\s+/)[0]);
  report('--list --category pedagogy lists the pedagogy checks only', l.join(',') === LIST.filter((x) => x.category === 'pedagogy').map((x) => x.id).join(','), l.join(','));
  for (const [what, extra, want] of [
    ['an unknown category', ['--category', 'style'], 'unknown category "style"'],
    ['--quality', ['--quality'], '--quality is gone: the reporting checks run by default'],
    ['--only of a check of check-spec', ['--only', 'rule-files'], '"rule-files" is not run by check-course: check-spec'],
    ['--only outside --category', ['--category', 'writing', '--only', 'sources'], '"sources" is in category sources'],
  ]) {
    const r = run(path.join(fx, 'valid'), [...lang, ...extra]);
    report(`${what} is a usage error, exit code 2`, r.code === 2 && r.lines.length === 0 && r.err.split('\n').filter(Boolean).length === 1 && r.err.includes(want), `got ${r.code}: ${r.err || r.lines.join(' | ')}`);
  }
}

// the schemas of the spec (schemas/*.schema.yaml, JSON Schema 2020-12 read by Ajv2020): valid's
// course.yaml and the frontmatter of each of its concept.md are valid against them
{
  const Ajv2020 = require('ajv/dist/2020').default;
  const yaml = require('./lib/yaml-lines');
  const md = require('./lib/md');
  const schema = (n) => new Ajv2020({ allErrors: true, logger: false }).compile(yaml.parse(fs.readFileSync(path.join(here, '..', 'schemas', n), 'utf8')));
  const errs = (v) => v.errors.map((e) => `${e.instancePath || '/'} ${e.message}`).slice(0, 2).join(' | ');
  const course = schema('course.schema.yaml');
  const front = schema('concept-frontmatter.schema.yaml');
  const cy = yaml.parse(fs.readFileSync(path.join(fx, 'valid', 'course.yaml'), 'utf8'));
  report('valid/course.yaml is valid against schemas/course.schema.yaml', course(cy), course.errors && errs(course));
  for (const c of cy.concepts) {
    const data = md.split(fs.readFileSync(path.join(fx, 'valid', c.dir, 'concept.md'), 'utf8')).data;
    report(`valid/${c.dir}/concept.md is valid against schemas/concept-frontmatter.schema.yaml`, front(data), front.errors && errs(front));
  }
}

// --concept looks at one concept only: an unlisted concept folder does not fail course-yaml
{
  const r = run(path.join(fx, 'broken', 'course-yaml-unlisted-folder'), ['--lang-dir', path.join(fx, 'lang'), '--only', 'course-yaml', '--concept', '0']);
  report('broken/course-yaml-unlisted-folder passes course-yaml with --concept 0', r.code === 0, notOk(r));
}

// the spec's own files (check-spec): fixtures/spec/valid passes, fixtures/spec/broken/<name> fails
// as its EXPECT says, and the repository's spec (this MAJOR's folder) passes
{
  const spec = (dir, extra) => {
    const r = spawnSync(process.execPath, [path.join(here, 'check-spec'), dir, ...extra], { encoding: 'utf8' });
    return { code: r.status, lines: r.stdout.split('\n').filter(Boolean), err: r.stderr };
  };
  const v = spec(path.join(fx, 'spec', 'valid'), []);
  report('spec/valid passes every spec check', v.code === 0, notOk(v));
  for (const name of fs.readdirSync(path.join(fx, 'spec', 'broken')).sort()) {
    const d = path.join(fx, 'spec', 'broken', name);
    const ex = Object.fromEntries(fs.readFileSync(path.join(d, 'EXPECT'), 'utf8').split('\n').filter(Boolean).map((l) => [l.slice(0, l.indexOf(':')), l.slice(l.indexOf(':') + 1).trim()]));
    const r = spec(d, ['--only', ex.check]);
    const hit = r.lines.filter((l) => l.startsWith(ex.check + ': fail: '));
    report(`spec/broken/${name} fails ${ex.check}`, r.code === 1 && hit.some((l) => l.includes(ex.message)), `expected "${ex.message}", got ${r.lines.join(' | ') || r.err}`);
    const others = failing(spec(d, [])).filter((l) => !l.startsWith(ex.check + ': '));
    if (others.length) report(`spec/broken/${name} breaks nothing else`, false, others.slice(0, 2).join(' | '));
  }
  const s = spec(path.join(here, '..'), []);
  report('the repository spec passes every spec check', s.code === 0, notOk(s));
}
// the dispatcher (specs/check-course): it runs this MAJOR's checks on a course declaring it,
// and refuses an unknown spec or MAJOR, naming it, with exit code 2
{
  const dispatcher = path.join(repo, 'specs', 'check-course');
  const disp = (dir, extra) => {
    const r = spawnSync(process.execPath, [dispatcher, dir, ...extra], { encoding: 'utf8' });
    return { code: r.status, lines: r.stdout.split('\n').filter(Boolean), err: r.stderr };
  };
  const v = disp(path.join(fx, 'valid'), ['--lang-dir', path.join(fx, 'lang')]);
  report("the dispatcher runs this MAJOR's checks on valid", v.code === 0 && ids(v).join(',') === runIds(), notOk(v) || ids(v).join(','));
  const w = disp(path.join(fx, 'valid'), ['--lang-dir', path.join(fx, 'lang'), '--category', 'writing']);
  report('the dispatcher passes --category through', w.code === 0 && ids(w).join(',') === runIds(['writing']), notOk(w) || ids(w).join(','));
  for (const [name, want] of [['other-spec', 'unknown spec "other"'], ['unknown-major', 'unknown MAJOR 9 of spec "linear-course"']]) {
    const r = disp(path.join(fx, 'dispatcher', name), []);
    report(`the dispatcher refuses dispatcher/${name}`, r.code === 2 && r.err.includes(want) && r.lines.length === 0, `expected exit 2 and "${want}", got ${r.code}: ${r.err || r.lines.join(' | ')}`);
  }
}
console.log(bad ? `${bad} unexpected result(s)` : 'all as expected');
process.exit(bad ? 1 : 0);
