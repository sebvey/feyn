#!/usr/bin/env node
'use strict';
// test-build: builds cafe (product-lines/linear-fr/1/course/samples/cafe, the spec's sample
// course) with teacher-builder/build-teacher into temporary folders and checks what a command
// can check of the classroom: the files of each part of composition.yaml, the course copy (diff
// -r), the learner templates (without their header comment), the permissions, the skills of the
// moments, the built CLAUDE.md (no placeholder left, no English word outside a slug, no list of the
// skills nor « Moments », no import of course.yaml, the instructions verbatim but for their
// placeholders, each instruction of linear-fr/1/instructions.yaml in CLAUDE.md or in one skill,
// once, each group heading followed by its purpose), the course map carte-du-cours.md and its import
// (the storyline first, its title, file and the text under its H1, each domain with its objective and file, each concept with its objective, prerequisites and
// folder, the annexes as annexes, each « L'essentiel » of cafe, the claim marks of its « L'essentiel »
// kept as written, the other course files, sources.yaml among them), sources.yaml
// read on demand (the part course-reads of composition.yaml), the three
// spots of the filling (no doubled parenthesis, no period after a phrase that ends with one, the
// plural of the domains), the teacher template (the implementation's, no instruction), course.lock,
// the classroom's git (one commit, clean), the default folders of the channels (under a temporary
// HOME), the refusal of a non-empty target and --force, --site-url, and the dispatcher's refusal of
// a spec MAJOR with no implementation folder, of one whose implementation folder has no teacher
// template, or of an unknown MAJOR.
// Then the link between the means and the protocol rules (linear-fr/1/means.yaml): every slug a
// `serves` names is a protocol rule of the spec, every protocol rule is served by a means or
// declared with no means, no means has an empty `serves`, each failure shown by a case that makes
// it fail; it prints the rules declared with no means. And the form marks and titles of the
// implementation's lexicon, the protocol rules' words, word for word.
// Exit 0 when every check passes, 1 otherwise; one line per failure.
const fs = require('fs');
const os = require('os');
const path = require('path');
const { spawnSync } = require('child_process');
const { createRequire } = require('module');

const BUILDER = __dirname;
const REPO = path.resolve(BUILDER, '..');
const BUILD = path.join(BUILDER, 'build-teacher');
const SPEC = path.join(REPO, 'product-lines', 'linear-fr', '1');
const COURSE = path.join(SPEC, 'course', 'samples', 'cafe');
const COURSE_ARG = path.relative(REPO, COURSE); // the course as given to the build, from the repository's root
const IMPL = path.join(BUILDER, 'linear-fr', '1'); // the implementation of the teacher of linear-fr@1
const TEMPLATES = path.join(IMPL, 'templates', 'learner');
const PLACEHOLDER = /\{[a-z_]+\.[a-z_]+\}/;
const INSTRUCTION_LINE = /^\*\*[a-z0-9-]+\*\* /;

const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'feyn-test-build-'));
const failures = [];
let checks = 0;
function check(ok, message) {
  checks++;
  if (!ok) failures.push(message);
  return ok;
}
function build(args, env = {}) {
  return spawnSync(process.execPath, [BUILD, ...args], { cwd: REPO, encoding: 'utf8', env: { ...process.env, ...env } });
}
const read = (p) => { try { return fs.readFileSync(p, 'utf8'); } catch (e) { return null; } };
const git = (dir, ...args) => spawnSync('git', ['-C', dir, ...args], { encoding: 'utf8' });
// the yaml lib of the spec directives the MAJOR declares (spec.yaml, `directives: <MAJOR>`)
const directivesLine = (read(path.join(SPEC, 'spec.yaml')) || '').split('\n').find((l) => /^directives\s*:/.test(l)) || '';
const directives = directivesLine.replace(/^directives\s*:\s*/, '').replace(/\s+#.*$/, '').trim();
const yaml = createRequire(path.join(REPO, 'spec-directives', directives, 'package.json'))('./lib/yaml-lines');

// ---- the build, with no --site-url
const out = path.join(tmp, 'classroom');
const r = build([COURSE_ARG, '--out', out]);
if (!check(r.status === 0, `build exits ${r.status}, not 0: ${(r.stderr || '').trim()}`)) {
  failures.forEach((f) => console.error(`test-build: ${f}`));
  process.exit(1);
}

for (const f of ['CLAUDE.md', 'carte-du-cours.md', 'course.lock', '.claude/settings.json', 'learner/apprenant.md', 'learner/observations.md', 'learner/parcours.md']) {
  check(fs.existsSync(path.join(out, f)), `${f} is missing`);
}
const diff = spawnSync('diff', ['-r', COURSE, path.join(out, 'course')], { encoding: 'utf8' });
check(diff.status === 0 && diff.stdout === '', `course/ is not a copy of ${COURSE_ARG}: ${diff.stdout.split('\n')[0]}`);
// learner memory: each learner template without its header comment, which stays in the source as a
// note for whoever edits it
for (const f of ['apprenant.md', 'observations.md', 'parcours.md']) {
  const source = read(path.join(TEMPLATES, f)) || '';
  const written = read(path.join(out, 'learner', f)) || '';
  check(source.startsWith('<!--'), `the learner template ${f} has no header comment`);
  check(!written.includes('<!--'), `learner/${f} keeps a comment`);
  check(written === source.replace(/^<!--[\s\S]*?-->\n/, ''), `learner/${f} is not the learner template without its header comment`);
}
check(fs.readdirSync(path.join(out, 'learner')).length === 3, 'learner/ holds other files than the three templates');

// the skills: one per moment that loads instructions, named feyn-teacher-<moment>
const skills = ['onboarding', 'resume', 'diagram', 'stop'];
const skillOf = (s) => `feyn-teacher-${s}`;
for (const s of skills) check(fs.existsSync(path.join(out, '.claude', 'skills', skillOf(s), 'SKILL.md')), `skill ${skillOf(s)} is missing`);
check(!fs.existsSync(path.join(out, '.claude', 'skills', skillOf('reset'))), 'skill feyn-teacher-reset exists, though the moment loads no instruction');
check(fs.readdirSync(path.join(out, '.claude', 'skills')).sort().join(',') === skills.map(skillOf).sort().join(','), 'the skills are not exactly feyn-teacher- onboarding, resume, diagram, stop');
const WHEN = {
  onboarding: "un nouvel apprenant, au premier message d'une session de cours",
  resume: "un apprenant qui revient, au premier message d'une session de cours",
  diagram: "l'apprenant demande un schéma, ou vient le message d'une unité pour laquelle concept.md déclare un schéma",
  stop: "l'apprenant dit que la session de cours s'arrête",
};
const skillText = {};
for (const s of skills) {
  const t = read(path.join(out, '.claude', 'skills', skillOf(s), 'SKILL.md')) || '';
  skillText[s] = t;
  const fm = /^---\nname: ([^\n]+)\ndescription: ([^\n]+)\n---\n/.exec(t);
  check(fm && fm[1] === skillOf(s), `skill ${skillOf(s)}: no frontmatter with name ${skillOf(s)}`);
  check(fm && fm[2].includes(WHEN[s]), `skill ${s}: its description does not say when it is used (${WHEN[s]})`);
  check(!PLACEHOLDER.test(t), `skill ${s} keeps a placeholder: ${(PLACEHOLDER.exec(t) || [])[0]}`);
}
check(skillText.onboarding.includes('`course/plan.md`'), 'skill onboarding does not name course/plan.md as what it reads');
// the onboarding questions of plan.md are given in the skill, so that the first message needs no
// read (instruction first-message-without-tools; the fresh test onboarding, #507)
{
  const plan = (read(path.join(COURSE, 'plan.md')) || '').split('\n');
  const at = plan.findIndex((l) => l.trim() === '## Accueil');
  const questions = plan.slice(at + 1).filter((l, i, a) => /^\d+\.\s/.test(l) && !a.slice(0, i).some((x) => /^## /.test(x)));
  check(at >= 0 && questions.length > 0 && questions.every((q) => skillText.onboarding.includes(q.trim())), 'skill onboarding does not give the onboarding questions of plan.md');
}
check(skillText.resume.includes('`learner/parcours.md`'), 'skill resume does not name learner/parcours.md as what it reads');
check(skillText.diagram.includes('`course/<dir>/concept.md`'), 'skill diagram does not name concept.md as what it reads');
for (const s of skills) check(!skillText[s].includes('teaching.md'), `skill ${s} names teaching.md, which a course of linear-fr@1 has not`);
check(skillText.stop.includes('`learner/parcours.md`'), 'skill stop does not name learner/parcours.md as what it reads');

// the built CLAUDE.md
const claude = read(path.join(out, 'CLAUDE.md')) || '';
check(!PLACEHOLDER.test(claude), `CLAUDE.md keeps a placeholder: ${(PLACEHOLDER.exec(claude) || [])[0]}`);
check(claude.includes('Posture : un barista patient, qui aide l\'apprenant à aider Cédric.'), 'CLAUDE.md lacks the posture of plan.md');
// the course map, the file carte-du-cours.md that CLAUDE.md imports: the storyline first, under its
// title « Fil rouge : <titre> », its file and the text under its H1 verbatim; each domain with its objective
// and file, then its concepts, each with its objective, prerequisites and folder; then both
// annexes as annexes, under « Annexes » and their own title, as their concept.md opens (« Annexe A1
// : … »), never as a concept; each « L'essentiel » of cafe verbatim; the other course files
const map = read(path.join(out, 'carte-du-cours.md')) || '';
check(claude.includes('\n@carte-du-cours.md\n'), 'CLAUDE.md does not import carte-du-cours.md');
const courseYaml = yaml.parse(read(path.join(COURSE, 'course.yaml')) || '');
const titleOf = (n) => (/^A\d+$/.test(String(n)) ? 'Annexe' : 'Concept') + ` ${n} : ${courseYaml.concepts.find((c) => String(c.number) === String(n)).title}`;
const annexAt = map.indexOf('\n## Annexes\n');
{
  const lines = (read(path.join(COURSE, 'storyline.md')) || '').split('\n');
  const h1 = lines.findIndex((l) => /^# /.test(l));
  const stop = lines.findIndex((l, i) => i > h1 && /^#{1,2} /.test(l));
  const opening = lines.slice(h1 + 1, stop < 0 ? lines.length : stop).join('\n').trim();
  const at = map.indexOf(`\n## Fil rouge : ${h1 >= 0 ? lines[h1].slice(2).trim() : ''}\n\n- Fichier : \`course/storyline.md\`\n\n${opening}\n`);
  check(h1 >= 0 && opening !== '' && at >= 0 && at < map.indexOf('\n## Domaine '), 'carte-du-cours.md does not open on the storyline, its title « Fil rouge : <titre> », its file and the text under its H1 verbatim');
}
for (const d of courseYaml.domains) {
  check(map.includes(`\n## Domaine ${d.number} : ${d.title}\n\n- Objectif : ${d.objective}\n- Fichier : \`course/${d.file}\`\n`), `carte-du-cours.md: domain ${d.number} lacks its title, objective or file`);
}
for (const c of courseYaml.concepts) {
  const annex = /^A\d+$/.test(String(c.number));
  const at = map.indexOf(`\n### ${titleOf(c.number)}\n`);
  const prerequisites = c.prerequisites.length ? c.prerequisites.map(titleOf).join(' ; ') : 'aucun';
  check(at >= 0 && map.slice(at).includes(`\n- Objectif : ${c.objective}\n- Prérequis : ${prerequisites}\n- Dossier : \`course/${c.dir}/\``), `carte-du-cours.md: ${titleOf(c.number)} lacks its objective, prerequisites or folder`);
  check(annex ? annexAt >= 0 && at > annexAt : at >= 0 && (annexAt < 0 || at < annexAt), `carte-du-cours.md: ${titleOf(c.number)} is not ${annex ? 'under « Annexes »' : 'in its domain'}`);
  const lines = (read(path.join(COURSE, c.dir, 'concept.md')) || '').split('\n');
  const e = lines.indexOf("## L'essentiel");
  const stop = lines.findIndex((l, i) => i > e && /^## /.test(l));
  const essentials = lines.slice(e + 1, stop < 0 ? lines.length : stop).join('\n').trim();
  check(e >= 0 && essentials !== '' && map.slice(at).includes(`\n#### L'essentiel\n\n${essentials}\n`), `carte-du-cours.md: ${titleOf(c.number)} lacks its « L'essentiel » verbatim`);
}
// the claim marks: the course map of cafe keeps those of its « L'essentiel » as written
// (instruction claim-marks-read-as-written); on cafe, those of annexes A1 and A2, of nature
// `cours` with no source (course/README.md 3.4: the nature alone, or followed by its sources)
{
  const claimMarks = [];
  for (const c of courseYaml.concepts) {
    const lines = (read(path.join(COURSE, c.dir, 'concept.md')) || '').split('\n');
    const e = lines.indexOf("## L'essentiel");
    const stop = lines.findIndex((l, i) => i > e && /^## /.test(l));
    const essentials = e < 0 ? '' : lines.slice(e + 1, stop < 0 ? lines.length : stop).join('\n');
    claimMarks.push(...(essentials.match(/\[[^\]\n]+\]\((?:consensus|école|fait|cours)(?::S\d+(?:,S\d+)*)?(?: "[a-z0-9-]+")?\)/gu) || []));
  }
  check(claimMarks.length > 0, 'no « L\'essentiel » of cafe holds a claim mark');
  for (const m of claimMarks) check(map.includes(m), `carte-du-cours.md does not keep the claim mark ${m} of a « L'essentiel » as written`);
}
// sources.yaml, one file at the course root, read on demand: the part course-reads of
// composition.yaml draws it from the course, and the course map names it among the course files
{
  const composition = yaml.parse(read(path.join(IMPL, 'composition.yaml')) || '') || {};
  const reads = ((composition.parts || []).find((p) => p.id === 'course-reads') || {}).draws || [];
  check(reads.some((d) => d.from === 'course' && d.source === 'sources.yaml' && /à la demande/.test(d.what || '')), 'composition.yaml: the part course-reads does not draw sources.yaml from the course, on demand');
  check(fs.existsSync(path.join(out, 'course', 'sources.yaml')) && map.includes('\n- `course/sources.yaml` : '), 'carte-du-cours.md does not name course/sources.yaml, or the classroom has none');
}
check(!/Concept A\d/.test(claude + map), 'CLAUDE.md or carte-du-cours.md titles an annex as a concept, « Concept A<n> »');
for (const f of ['course/plan.md', 'course/storyline.md', 'course/glossary.md']) {
  check(map.includes('\n- `' + f + '` : '), `carte-du-cours.md does not name the course file ${f}`);
}
check(!map.includes('teaching.md') && !claude.includes('teaching.md'), 'CLAUDE.md or carte-du-cours.md names teaching.md, which the course has not');
check(!PLACEHOLDER.test(map), 'carte-du-cours.md keeps a placeholder');
// the diagram of concept 0, which CLAUDE.md does not name, is copied with its concept
check(fs.existsSync(path.join(out, 'course', 'concepts', '00-extraction', 'extraction-et-force.svg')), 'the diagram of concept 0 is not copied');
check(claude.includes('canal `next`'), 'CLAUDE.md does not state the channel next (« canal `next` »)');
// one course map: no import of course.yaml, no « Course map » nor « Course files »; and no line
// that repeats the skills, which Claude Code presents with their description
check(!/@course\/course\.yaml|^## Course (map|files)|^## Moments|^- `\.claude\/skills\/`/m.test(claude), 'CLAUDE.md imports course.yaml, or holds « Course map », « Course files », « Moments » or a line .claude/skills/');
for (const s of skills) check(!claude.includes(skillOf(s)), `CLAUDE.md names the skill ${skillOf(s)}`);
// the frame is French: no English word outside an instruction's slug or a group heading
const english = claude.split('\n').map((l, i) => [i + 1, l]).filter(([, l]) => /\b(the|you|and|of)\b/.test(l) && !/^(\*\*[a-z-]+\*\*|#+ .*\(`[a-z-]+`\))/.test(l));
check(english.length === 0, `CLAUDE.md holds an English word outside a slug, line ${english.map(([n]) => n).join(', ')}`);
check(claude.includes('(site non publié)') && !claude.includes('http'), 'CLAUDE.md: without --site-url, the site addresses are not « (site non publié) »');

// the three spots of the filling, in CLAUDE.md and in the skills
for (const [name, text] of [['CLAUDE.md', claude], ...skills.map((s) => [skillOf(s), skillText[s]])]) {
  check(!text.includes('((site'), `${name}: a link reads « ((site non publié)) », a doubled parenthesis`);
  const doubled = text.split('\n').find((l) => /\. »\.|\.\./.test(l));
  check(!doubled, `${name}: a period follows a phrase that ends with one: ${doubled}`);
  check(!/ses \d+ domaines/.test(text), `${name}: the count of domains reads « ses <number> domaines » whatever the number`);
}
check(claude.includes('](site non publié)'), 'CLAUDE.md: a link does not read « (site non publié) » once');
check(skillText.stop.includes('« Je sauvegarde ta progression, un instant. »\n') || skillText.stop.includes('« Je sauvegarde ta progression, un instant. » '), 'skill feyn-teacher-stop: the stop phrase is not followed by the instruction\'s text without a second period');

// the instructions, linear-fr/1/instructions.yaml, read with the yaml lib of the spec directives
// the MAJOR declares (above): its groups, each instruction as the build writes it, `**<id>** <text>`
// and its why on a line `*Pourquoi :* <why>`
const instructionsDoc = yaml.parse(read(path.join(IMPL, 'instructions.yaml')) || '');
const groups = instructionsDoc.groups;
const source = new Map(groups.flatMap((g) => g.instructions).map((r) => [r.id, `**${r.id}** ${r.text}` + (r.why ? `\n*Pourquoi :* ${r.why}` : '')]));
const escape = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
// a text of the instructions as built: a placeholder as fill() treats it (« {k} » with the period
// after it, ({k}) with its parentheses, a bare {k}) stands for its value
const patternOf = (t) => new RegExp('^' + t.split(/« \{[a-z_]+\.[a-z_]+\} »\.?|\(\{[a-z_]+\.[a-z_]+\}\)|\{[a-z_]+\.[a-z_]+\}/).map(escape).join('[\\s\\S]+?') + '$');

// every instruction, once, in CLAUDE.md or in the skill of its moment
const slugsOf = (text) => text.split('\n').map((l) => /^\*\*([a-z0-9-]+)\*\* /.exec(l)).filter(Boolean).map((m) => m[1]);
const all = [...source.keys()];
const where = new Map(all.map((s) => [s, []]));
for (const [name, text] of [['CLAUDE.md', claude], ...skills.map((s) => [skillOf(s), skillText[s]])]) {
  for (const s of slugsOf(text)) {
    if (!where.has(s)) check(false, `${name} holds an instruction ${s} that instructions.yaml has not`);
    else where.get(s).push(name);
  }
}
for (const [s, at] of where) check(at.length === 1, `instruction ${s} is in ${at.length ? at.join(', ') : 'nothing'}, not in exactly one place`);
const MOMENT_OF = { 'first-message-without-tools': 'onboarding', 'profile-written': 'onboarding', 'resume-opening-sentence': 'resume', 'diagram-shown-by-link': 'diagram', 'requested-diagram-shown': 'diagram', 'stop-opening-sentence': 'stop', 'hurried-departure': 'stop' };
for (const [s, m] of Object.entries(MOMENT_OF)) check((where.get(s) || [])[0] === skillOf(m), `instruction ${s} is not in the skill ${skillOf(m)}`);
// the diagram declared for a unit is shown unasked: a permanent instruction, so that the teacher
// knows it at every message, the moment diagram loaded at that unit too (its `when`, in the
// description of the skill feyn-teacher-diagram, checked above)
check((where.get('declared-diagram-shown') || [])[0] === 'CLAUDE.md', 'instruction declared-diagram-shown is not in CLAUDE.md');
const order = slugsOf(claude);
check(order.join(',') === all.filter((s) => where.get(s)[0] === 'CLAUDE.md').join(','), 'the instructions of CLAUDE.md are not in the order of linear-fr/1/instructions.yaml');
// every group heading is followed by its purpose, in CLAUDE.md and in the skills, each group once
const HEADING = /^## .+ \(`([a-z0-9-]+)`\)$/;
const headingsOf = (text) => {
  const lines = text.split('\n');
  let fence = false;
  const found = [];
  lines.forEach((l, i) => {
    if (/^```/.test(l)) fence = !fence;
    if (!fence && HEADING.test(l)) found.push(i);
  });
  return { lines, found };
};
const headed = [];
for (const [name, text] of [['CLAUDE.md', claude], ...skills.map((s) => [skillOf(s), skillText[s]])]) {
  const { lines, found } = headingsOf(text);
  for (const i of found) {
    const id = HEADING.exec(lines[i])[1];
    headed.push(id);
    const next = lines.slice(i + 1).find((l) => l.trim() !== '') || '';
    const g = groups.find((x) => x.id === id);
    check(g && lines[i] === `## ${g.title} (\`${g.id}\`)` && patternOf(g.purpose).test(next), `${name}: ${lines[i]} is not a group heading followed by its purpose`);
  }
}
check(headed.length === groups.length && [...headed].sort().join(',') === groups.map((g) => g.id).sort().join(','), `${headed.length} group headings in CLAUDE.md and the skills, not the ${groups.length} groups of instructions.yaml once each`);

// each instruction as built is its text, verbatim but for its placeholders: an instruction block
// of the built text runs from its **slug** line to the next instruction or heading; a placeholder
// stands for its value, a period after its » included (dropped when the value ends with one), its
// parentheses included (one pair kept when the value has its own)
function instructionBlocks(text) {
  const blocks = new Map();
  let cur = null;
  let fence = false;
  const close = () => {
    if (!cur) return;
    while (cur.lines.length && cur.lines[cur.lines.length - 1].trim() === '') cur.lines.pop();
    blocks.set(cur.slug, cur.lines.join('\n'));
    cur = null;
  };
  for (const l of text.split('\n')) {
    if (!fence && /^#/.test(l)) { close(); continue; }
    const m = !fence && /^\*\*([a-z0-9-]+)\*\* /.exec(l);
    if (/^```/.test(l)) fence = !fence;
    if (m) { close(); cur = { slug: m[1], lines: [l] }; continue; }
    if (cur) cur.lines.push(l);
  }
  close();
  return blocks;
}
let compared = 0;
for (const [name, text] of [['CLAUDE.md', claude], ...skills.map((s) => [skillOf(s), skillText[s]])]) {
  for (const [slug, built] of instructionBlocks(text)) {
    if (!source.has(slug)) continue;
    compared++;
    check(patternOf(source.get(slug)).test(built), `${name}: instruction ${slug} is not its text with its placeholders filled`);
  }
}
check(compared === all.length, `${compared} instructions compared with instructions.yaml, not ${all.length}`);
check(!['onboarding', 'resume', 'diagram', 'stop'].some((g) => claude.includes(`(\`${g}\`)`)), 'CLAUDE.md holds a group a moment loads');
check(claude.includes('\n**save-next-step** '), 'CLAUDE.md lacks the save-point instruction save-next-step');
check(!claude.includes('teaching.md') && !/\bserves\b/.test(claude), 'CLAUDE.md names teaching.md, or holds the serves of an instruction');

// the teacher template: the implementation's, the only one, and the frame only
const template = read(path.join(IMPL, 'CLAUDE.template.md')) || '';
check(template !== '', 'linear-fr/1/CLAUDE.template.md is missing: the teacher template is the implementation\'s');
check(!fs.existsSync(path.join(BUILDER, 'CLAUDE.template.md')), 'teacher-builder/CLAUDE.template.md exists: the teacher template is the implementation\'s, not the engine\'s');
check(!template.split('\n').some((l) => INSTRUCTION_LINE.test(l)), 'linear-fr/1/CLAUDE.template.md holds an instruction line');

// the permissions
let settings = {};
try { settings = JSON.parse(read(path.join(out, '.claude', 'settings.json'))); } catch (e) { check(false, '.claude/settings.json is not JSON'); }
const allow = (settings.permissions && settings.permissions.allow) || [];
const deny = (settings.permissions && settings.permissions.deny) || [];
check(allow.includes('Bash(git add learner/)'), 'settings.json does not allow git add learner/');
check(allow.some((a) => /^Bash\(git commit/.test(a)), 'settings.json does not allow git commit');
