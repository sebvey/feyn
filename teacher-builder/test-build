const ph = implLexicon.phrases || {};
const rulesText = rulesFile ? (read(path.join(SPEC, rulesFile)) || '').replace(/\s+/g, ' ') : '';
const FORM_MARKS = [
  [`« **${ph.storyline_lead}** »`, 'storyline_lead'],
  [`« **${ph.off_storyline_lead}** »`, 'off_storyline_lead'],
  [`« **${ph.question_lead}** »`, 'question_lead'],
  [`« **${String(ph.questions_announce).replace('{count}', '<nombre>')}** »`, 'questions_announce'],
  [`« ${ph.next_lead} <ce qui vient>. ${ph.continue_prompt} »`, 'next_lead and continue_prompt'],
  [`« ${String(ph.concept_title).replace('{n}', '<n>').replace('{title}', '<titre>')} »`, 'concept_title'],
  [`« ${String(ph.domain_title).replace('{n}', '<n>').replace('{title}', '<titre>')} »`, 'domain_title'],
  [`« ${String(ph.storyline_title).replace('{title}', '<titre>')} »`, 'storyline_title'],
  [`« ${String(ph.reference_model).replace('{n}', '<n>').replace('{title}', '<titre>')} »`, 'reference_model'],
];
for (const [formMark, key] of FORM_MARKS) check(rulesText.includes(formMark), `lexicon.yaml: phrases.${key} is not the protocol rules' word for word: ${formMark}`);

fs.rmSync(tmp, { recursive: true, force: true });
