check(noTemplate.status === 2 && /teacher-builder\/linear-fr\/1\/CLAUDE\.template\.md/.test(noTemplate.stderr) && !fs.existsSync(path.join(tmp, 'out-no-template')), `a MAJOR whose implementation folder has no teacher template is not refused with exit 2 naming the file: ${noTemplate.status} ${(noTemplate.stderr || '').trim()}`);

// ---- the means and the protocol rules they serve, both ways (linear-fr/1/means.yaml): the
// protocol rules are those of the rule file spec.yaml declares for the teacher
const manifest = yaml.parse(read(path.join(SPEC, 'spec.yaml')) || '');
const rulesFile = manifest.products && manifest.products.teacher && manifest.products.teacher.rules;
const rulesDoc = rulesFile ? yaml.parse(read(path.join(SPEC, rulesFile)) || '') : null;
const ruleIds = rulesDoc ? rulesDoc.groups.flatMap((g) => (g.rules || []).map((r) => r.id)) : [];
check(ruleIds.length > 0, `no protocol rule read from ${rulesFile ? path.join('product-lines/linear-fr/1', rulesFile) : 'spec.yaml (no products.teacher.rules)'}`);
const meansDoc = yaml.parse(read(path.join(IMPL, 'means.yaml')) || '') || {};
const KINDS = ['template', 'permission', 'hook', 'script', 'build'];

// the failures of the link, for the instructions, the means with no text and the declared rules
// given; one message per failure, each starting with what it is: `unknown`, `unserved`, `empty`,
// or `form`
function linkFailures(instructionGroups, meansList, declaredList, rules) {
  const out = [];
  const known = new Set(rules);
  const served = new Set();
  const ids = new Set();
  const all = [
    ...instructionGroups.flatMap((g) => (g.instructions || []).map((r) => ({ where: `instruction ${r.id}`, id: r.id, serves: r.serves }))),
    ...meansList.map((m) => ({ where: `means ${m.id}`, id: m.id, serves: m.serves, m })),
  ];
  for (const x of all) {
    if (ids.has(x.id)) out.push(`form: ${x.where}: its id is taken by another instruction or means`);
    ids.add(x.id);
    if (x.m && (!KINDS.includes(x.m.kind) || typeof x.m.source !== 'string' || !x.m.source)) out.push(`form: ${x.where}: no kind among ${KINDS.join(', ')}, or no source`);
    if (!Array.isArray(x.serves) || x.serves.length === 0) { out.push(`empty: ${x.where} serves no protocol rule`); continue; }
    for (const slug of x.serves) {
      if (!known.has(slug)) out.push(`unknown: ${x.where} serves ${slug}, which is no protocol rule of the spec`);
      else served.add(slug);
    }
  }
  const declared = new Set();
  for (const d of declaredList) {
    if (!d || !known.has(d.rule)) { out.push(`unknown: the declared rule ${d && d.rule} is no protocol rule of the spec`); continue; }
    if (typeof d.reason !== 'string' || !d.reason.trim() || !d.decided || typeof d.decided.by !== 'string' || !/^\d{4}-\d\d-\d\d$/.test(String(d.decided.date))) {
      out.push(`form: the declared rule ${d.rule} lacks its reason, who decided it or when`);
    }
    if (served.has(d.rule)) out.push(`form: the declared rule ${d.rule} is served by a means`);
    declared.add(d.rule);
  }
  for (const r of rules) if (!served.has(r) && !declared.has(r)) out.push(`unserved: protocol rule ${r} is served by no means and is not declared in means.yaml`);
  return out;
}
const meansList = Array.isArray(meansDoc.means) ? meansDoc.means : [];
const declaredList = Array.isArray(meansDoc.declared) ? meansDoc.declared : [];
const link = linkFailures(groups, meansList, declaredList, ruleIds);
for (const f of link) check(false, `means.yaml: ${f}`);
check(link.length === 0, `means.yaml: ${link.length} failures of the link between the means and the protocol rules`);

// each of the three failures shown by a case that makes it fail: a copy of the instructions with
// a slug that names no protocol rule, one where a rule loses every means, one with an empty serves
const copy = (x) => JSON.parse(JSON.stringify(x));
const failsWith = (kind, g, m, d) => linkFailures(g, m, d, ruleIds).some((f) => f.startsWith(`${kind}:`));
{
  const g = copy(groups);
  g[0].instructions[0].serves = [...g[0].instructions[0].serves, 'no-such-protocol-rule'];
  check(failsWith('unknown', g, meansList, declaredList), 'the link does not fail on a serves that names no protocol rule');
}
{
  const target = ruleIds.find((r) => !declaredList.some((d) => d.rule === r));
  const g = copy(groups).map((x) => ({ ...x, instructions: x.instructions.map((r) => ({ ...r, serves: r.serves.filter((s) => s !== target) })).filter((r) => r.serves.length) }));
  const m = copy(meansList).map((x) => ({ ...x, serves: x.serves.filter((s) => s !== target) })).filter((x) => x.serves.length);
  check(failsWith('unserved', g, m, declaredList) && !failsWith('unserved', groups, meansList, declaredList), `the link does not fail on a protocol rule served by no means (${target} taken from every means)`);
}
{
  const g = copy(groups);
  g[0].instructions[0].serves = [];
  const m = copy(meansList);
  if (m.length) m[0].serves = [];
  check(failsWith('empty', g, meansList, declaredList) && (!m.length || failsWith('empty', groups, m, declaredList)), 'the link does not fail on an instruction or a means with an empty serves');
}
// the rules declared with no means, printed
for (const d of declaredList) console.log(`test-build: declared with no means: ${d.rule} (${d.decided && d.decided.by}, ${d.decided && d.decided.date}): ${String(d.reason || '').replace(/\s+/g, ' ').trim()}`);

// the form marks and the titles the protocol rules write word for word are the lexicon's words
