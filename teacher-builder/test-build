fs.mkdirSync(path.join(bare, 'product-lines', 'linear-fr', '1'), { recursive: true });
fs.copyFileSync(BUILD, path.join(bare, 'teacher-builder', 'build-teacher'));
fs.copyFileSync(path.join(SPEC, 'spec.yaml'), path.join(bare, 'product-lines', 'linear-fr', '1', 'spec.yaml'));
const noBuild = spawnSync(process.execPath, [path.join(bare, 'teacher-builder', 'build-teacher'), courseAt(path.join(bare, 'course'), 'linear-fr@1'), '--out', path.join(tmp, 'out-bare')], { encoding: 'utf8' });
check(noBuild.status === 2 && /has no implementation folder teacher-builder\/linear-fr\/1\//.test(noBuild.stderr) && !fs.existsSync(path.join(tmp, 'out-bare')), `a MAJOR with no implementation folder is not refused with exit 2: ${noBuild.status} ${(noBuild.stderr || '').trim()}`);
// a MAJOR whose implementation folder has its render-parts and its schema but no teacher template
