#!/usr/bin/env node
'use strict';
// render-parts <course-dir> [--site-url <base>] [--channel <c>]
// The part of the teacher implementation of linear-fr@1 that reads the spec and the course: it
// renders the five parts of composition.yaml (this folder) as text for a course and prints them to
// stdout as one JSON document, whose shape parts.schema.yaml fixes and README.md (this folder)
// describes. It reads the instructions (instructions.yaml, by group with their purpose), the
// composition, the lexicon and the learner templates of this folder, the spec MAJOR's lexicon of
// the course files, and the course through the spec's parser (course/parser.js, as the site build
// reads it), and fills every {group.key}, {course.<name>} and {classroom.<name>}. What each part
// becomes in a classroom is build-teacher's (teacher-builder/). Writes nothing. Exit 0 rendered, 1
// an input it cannot read (a placeholder in neither lexicon, a moment naming an unknown group, an
// instruction or a group out of its form), 2 a usage error.
const fs = require('fs');
const path = require('path');
const { createRequire } = require('module');

// here is teacher-builder/<name>/<MAJOR>, the implementation of the spec MAJOR
// product-lines/<name>/<MAJOR>: the implementation reads the spec, the spec never reads it
const HERE = __dirname;
const REPO = path.resolve(HERE, '..', '..', '..');
const MAJOR = path.join(REPO, 'product-lines', path.basename(path.dirname(HERE)), path.basename(HERE));
const UNPUBLISHED = '(site non publié)';
const PARTS = ['permanent', 'on-demand', 'course-reads', 'learner-memory', 'permissions'];

function usage(code) {
  const out = code ? console.error : console.log;
  out('usage: render-parts <course-dir> [--site-url <base>] [--channel <c>]');
  out('prints the five parts of composition.yaml rendered for <course-dir>, as JSON (README.md);');
  out('without --site-url the site addresses are « (site non publié) »; --channel defaults to next');
  process.exit(code);
}
function fail(message) {
  console.error(`render-parts: ${message}`);
  process.exit(1);
}

// ---- arguments
let courseDir = null;
let siteUrl = null;
let channel = 'next';
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  const value = () => {
    if (i + 1 >= argv.length) { console.error(`render-parts: ${a} needs a value`); usage(2); }
    return argv[++i];
  };
  if (a === '--help' || a === '-h') usage(0);
  else if (a === '--site-url') siteUrl = value();
  else if (a === '--channel') channel = value();
  else if (a.startsWith('-')) { console.error(`render-parts: unknown option ${a}`); usage(2); }
  else if (courseDir === null) courseDir = a;
  else { console.error(`render-parts: one course folder only (got ${courseDir} and ${a})`); usage(2); }
}
if (courseDir === null) usage(2);
if (!channel) usage(2);
courseDir = path.resolve(courseDir);

const rel = (p) => path.relative(process.cwd(), p) || p;
const read = (p) => {
  try { return fs.readFileSync(p, 'utf8'); } catch (e) { return fail(`cannot read ${rel(p)}`); }
};

// ---- the spec directives this MAJOR follows (spec.yaml, `directives: <MAJOR>`): their lib and package
const specYaml = read(path.join(MAJOR, 'spec.yaml'));
const lineOf = (key) => {
  const l = specYaml.split('\n').find((x) => new RegExp(`^${key}\\s*:`).test(x));
  return l && l.replace(new RegExp(`^${key}\\s*:\\s*`), '').replace(/\s+#.*$/, '').trim().replace(/^(['"])(.*)\1$/, '$2');
};
const directives = lineOf('directives');
if (!/^\d+$/.test(directives || '')) fail(`${rel(MAJOR)}/spec.yaml declares no directives MAJOR`);
const DIRECTIVES = path.join(REPO, 'spec-directives', directives);
if (!fs.existsSync(path.join(DIRECTIVES, 'package.json'))) fail(`no spec directives at ${rel(DIRECTIVES)}`);
const req = createRequire(path.join(DIRECTIVES, 'package.json'));
req('./lib/deps').need();
const yaml = req('./lib/yaml-lines');
const SPEC = `${lineOf('name')}@${lineOf('major')}`;

const parseYaml = (p) => {
  try { return yaml.parse(read(p)); } catch (e) { return fail(`${rel(p)}: ${e.message}`); }
};
// the course, through the parser of the spec MAJOR (course/parser.js), given the directives' lib,
// with the MAJOR's lexicon of the course files and form, as the site build reads it
const parser = require(path.join(MAJOR, 'course', 'parser.js'))((name) => req('./lib/' + name));
const ctx = parser.load(courseDir, { specLexicon: path.join(MAJOR, 'course', 'lexicon.yaml'), specForm: path.join(MAJOR, 'course', 'form.yaml') });
if (!ctx.cy) fail(`${rel(courseDir)}: ${ctx.cyError ? ctx.cyError.message : 'no course.yaml'}`);
if (!ctx.usable) fail(`${rel(courseDir)}/course.yaml has no domains or no concepts (check-course says more)`);
if (!ctx.lexiconOk) fail(ctx.lexiconError.message);
const course = ctx.cy;
const composition = parseYaml(path.join(HERE, 'composition.yaml'));
// the words the instructions cite: the implementation's lexicon, then the spec's lexicon of the course files
const lexicons = [parseYaml(path.join(HERE, 'lexicon.yaml')), parseYaml(path.join(MAJOR, 'course', 'lexicon.yaml'))];
const LEARNER_TEMPLATES = path.join(HERE, 'templates', 'learner');
if (typeof course.id !== 'string' || !course.id) fail('course.yaml has no id');
if (course.spec !== SPEC) fail(`${rel(courseDir)}/course.yaml declares spec ${course.spec}, not ${SPEC}`);
const parts = new Map((composition.parts || []).map((p) => [p.id, p]));
for (const id of PARTS) if (!parts.has(id)) fail(`composition.yaml has no part ${id}`);

// ---- the course parameters (course.yaml) and the classroom parameters
let site = null;
if (siteUrl) site = siteUrl.endsWith('/') ? siteUrl : siteUrl + '/';
const PARAMS = {
  course: {
    id: course.id,
    title: course.title,
    domain_count: String((course.domains || []).length),
    storyline: course.storyline,
    glossary: course.glossary,
  },
  classroom: {
    ...(site
      // diagram_url: a diagram on its concept page, the anchor of the site's url-scheme.yaml (anchors.diagram);
      // storyline_url: the storyline page, pages.storyline of the same url-scheme.yaml
      ? { site_url: site, domains_url: `${site}domaines/`, storyline_url: `${site}fil-rouge/`, domain_url: `${site}domaines/{n}/`, concept_url: `${site}concepts/{nn}/`, diagram_url: `${site}concepts/{nn}/#schema-{file}` }
      : { site_url: UNPUBLISHED, domains_url: UNPUBLISHED, storyline_url: UNPUBLISHED, domain_url: UNPUBLISHED, concept_url: UNPUBLISHED, diagram_url: UNPUBLISHED }),
    channel,
  },
};

// a placeholder {group.key}: a course or classroom parameter, or a key of one of the two lexicons;
// a list value is its items in « », separated by commas, and replaces the « » around the
// placeholder when there are some
const quote = (v) => `« ${v} »`;
function valueOf(group, key, where) {
  if (group === 'course' || group === 'classroom') {
    const v = PARAMS[group][key];
    if (typeof v !== 'string' || !v) fail(`${where}: {${group}.${key}} is not a ${group} parameter`);
    return v;
  }
  for (const lex of lexicons) {
    if (lex[group] && Object.prototype.hasOwnProperty.call(lex[group], key)) return lex[group][key];
  }
  return fail(`${where}: {${group}.${key}} is in neither lexicon`);
}
// the filling keeps the sentence whole: a phrase in « » that ends with its own period is not
// followed by the period the instruction adds after the »; a value already in parentheses, inside the
// parentheses of a link, keeps one pair
const ENDS_SENTENCE = /\.$/;
function fill(text, where) {
  return text
    .replace(/« \{([a-z_]+)\.([a-z_]+)\} »(\.?)/g, (m, g, k, dot) => {
      const v = valueOf(g, k, where);
      const last = String(Array.isArray(v) ? v[v.length - 1] : v);
      const filled = Array.isArray(v) ? v.map(quote).join(', ') : quote(v);
      return filled + (dot && ENDS_SENTENCE.test(last) ? '' : dot);
    })
    .replace(/\(\{([a-z_]+)\.([a-z_]+)\}\)/g, (m, g, k) => {
      const v = String(valueOf(g, k, where));
      return /^\(.*\)$/.test(v) ? v : `(${v})`;
    })
    .replace(/\{([a-z_]+)\.([a-z_]+)\}/g, (m, g, k) => {
      const v = valueOf(g, k, where);
      return Array.isArray(v) ? v.map(quote).join(', ') : String(v);
    });
}
// a bare key in a `what` of the composition (`headings.onboarding`): its value in « »
const fillWhat = (what) => what.replace(/\b(headings|case_fields)\.([a-z_]+)\b/g, (m, g, k) => quote(valueOf(g, k, 'composition.yaml')));

// ---- the instructions, instructions.yaml, in its order: a group, rendered "## <title> (`<id>`)",
// its purpose, then each instruction "**<id>** <text>", its why on a line "*Pourquoi :* <why>";
// `serves` is the link test-build checks, never rendered to the teacher
const GROUP_KEYS = ['id', 'title', 'purpose', 'instructions'];
const INSTRUCTION_KEYS = ['id', 'text', 'serves', 'why'];
function parseInstructions(doc) {
  const groups = [];
  for (const g of (doc && Array.isArray(doc.groups) ? doc.groups : [])) {
    const where = `instructions.yaml: group ${g && g.id}`;
    if (!g || typeof g.id !== 'string' || typeof g.title !== 'string' || typeof g.purpose !== 'string' || !Array.isArray(g.instructions)) {
      fail(`${where} lacks an id, a title, a purpose or its instructions`);
    }
    const extra = Object.keys(g).filter((k) => !GROUP_KEYS.includes(k));
    if (extra.length) fail(`${where} has keys the form has not: ${extra.join(', ')}`);
    const group = { id: g.id, heading: `## ${g.title} (\`${g.id}\`)`, purpose: g.purpose, instructions: [] };
    for (const r of g.instructions) {
      if (!r || typeof r.id !== 'string' || typeof r.text !== 'string') fail(`${where}: an instruction lacks an id or a text`);
      const bad = Object.keys(r).filter((k) => !INSTRUCTION_KEYS.includes(k));
      if (bad.length) fail(`${where}: instruction ${r.id} has keys the form has not: ${bad.join(', ')}`);
      const text = `**${r.id}** ${r.text}` + (r.why ? `\n*Pourquoi :* ${r.why}` : '');
      group.instructions.push({ slug: r.id, text });
    }
    groups.push(group);
  }
  return groups;
}
const groups = parseInstructions(parseYaml(path.join(HERE, 'instructions.yaml')));
if (!groups.length) fail(`${rel(HERE)}/instructions.yaml holds no group`);
const groupById = new Map(groups.map((g) => [g.id, g]));
if (groupById.size !== groups.length) fail('instructions.yaml: two groups share an id');

// ---- the moments: a moment loads groups of instructions.yaml whole, each named by its id
const moments = (parts.get('on-demand').moments || []).map((m) => {
  const loaded = (m.groups || []).map((id) => groupById.get(id) || fail(`composition.yaml: moment ${m.id} names ${id}, not a group of instructions.yaml`));
  return { ...m, loaded };
});
const onDemand = new Set(moments.flatMap((m) => m.loaded.map((g) => g.id)));

const instructionText = (r) => fill(r.text, `instruction ${r.slug}`);
const purposeText = (g) => fill(g.purpose, g.heading);
const blocks = (list) => list.filter(Boolean).join('\n\n');
const groupText = (g) => blocks([g.heading, purposeText(g), ...g.instructions.map(instructionText)]);

// the permanent instructions: every group no moment loads, in the order of instructions.yaml
const permanentInstructions = () => groups.filter((g) => !onDemand.has(g.id)).map(groupText).join('\n\n');
// the instructions of a moment, its groups in its order
const momentInstructions = (m) => m.loaded.map(groupText).join('\n\n');

// ---- the course: posture, map, files
const lex = (group, key) => valueOf(group, key, 'render-parts');
const slot = (pattern, values) => pattern.replace(/\{([a-z]+)\}/g, (m, k) => (k in values ? String(values[k]) : m));
function posture() {
  const plan = read(path.join(courseDir, 'plan.md')).split('\n');
  const heading = `## ${lex('headings', 'onboarding')}`;
  const at = plan.findIndex((l) => l.trim() === heading);
  if (at < 0) fail(`plan.md has no heading « ${heading} »`);
  const para = [];
  for (const l of plan.slice(at + 1)) {
    if (l.trim() === '' && para.length) break;
    if (l.trim() === '') continue;
    if (/^(#|\d+\.\s|[-*]\s)/.test(l)) break;
    para.push(l);
  }
  if (!para.length) fail(`plan.md has no posture paragraph under « ${heading} »`);
  return para.join('\n');
}
// the concepts as the parser reads them (number normalised, `annex` for an annex `A<n>`): a
// numbered concept is titled in the words of `phrases.concept_title`, an annex as its concept.md
// opens, `<block_kinds.annex> <id><block_kinds.separator><title>` (« Annexe A1 : Les méthodes »)
const concepts = new Map(ctx.concepts.map((c) => [c.number, c]));
const annexTitle = (c) => {
  const word = ctx.word('block_kinds', 'annex');
  const sep = ctx.word('block_kinds', 'separator');
  if (!word || !sep) fail('course/lexicon.yaml has no block_kinds.annex or block_kinds.separator');
  return `${word} ${c.number}${sep}${c.entry.title}`;
};
const conceptTitle = (c) => (c.annex ? annexTitle(c) : slot(lex('phrases', 'concept_title'), { n: c.number, title: c.entry.title }));
const domainTitle = (d) => slot(lex('phrases', 'domain_title'), { n: d.number, title: d.title });
// The course map, the file of the classroom CLAUDE.md imports (decision of the maintainer,
// 2026-11-09, #790): each domain in the order of the course, its title, objective and file, then
// each of its concepts; then the annexes, which no domain holds, under a heading of their own; each
// concept and annex with its title, objective, prerequisites, folder and files, and « L'essentiel »
// verbatim, read through the spec's parser (the head of its concept.md); then the other course
// files. It opens on the storyline, titled in the words of `phrases.storyline_title`, with its file
// and the text under its H1 verbatim, the world and the learner's role in it, so that the teacher
// knows them before any read (instruction onboarding-closing-sentence, #801). Its words are
// French, the spec's language, as the template's (decision language-policy).
const COURSE_MAP_FILE = 'carte-du-cours.md';
const MAP = {
  title: 'Carte du cours',
  intro: 'Le fil rouge, puis les domaines dans l\'ordre du parcours, chacun avec ses concepts dans leur ordre, puis les annexes, hors du parcours. Les chemins sont ceux de la classe ; tout ce qui est sous `course/` est en lecture seule. Ce fichier est construit avec la classe à partir du cours : il ne se modifie pas à la main.',
  objective: 'Objectif',
  prerequisites: 'Prérequis',
  none: 'aucun',
  file: 'Fichier',
  folder: 'Dossier',
  annexes: 'Annexes',
  others: 'Autres fichiers du cours',
};
// the files of a concept folder the course has, each with what it holds
const CONCEPT_FILES = [['concept.md', 'la matière'], ['sources.md', 'les sources']];
// « L'essentiel » of a concept or an annex: the lines of the head of its concept.md (the form's
// head, `headings.essentials`), as the parser reads them, verbatim
function essentials(c) {
  const head = ctx.parts(c).head;
  const text = head ? head.lines.map((l) => l.t).join('\n').trim() : '';
  if (!text) fail(`${c.dir}/concept.md has no « ${ctx.word('headings', 'essentials')} »`);
  return text;
}
function conceptEntry(c) {
  const prerequisites = (c.entry.prerequisites || []).map((n) => {
    const p = concepts.get(String(n));
    if (!p) fail(`course.yaml: concept ${c.number} names prerequisite ${n}, which is not in concepts`);
    return conceptTitle(p);
  });
  const files = CONCEPT_FILES.filter(([f]) => ctx.exists(`${c.dir}/${f}`)).map(([f, what]) => `\`${f}\` (${what})`);
  return blocks([
    `### ${conceptTitle(c)}`,
    [
      `- ${MAP.objective} : ${c.entry.objective}`,
      `- ${MAP.prerequisites} : ${prerequisites.length ? prerequisites.join(' ; ') : MAP.none}`,
      `- ${MAP.folder} : \`course/${c.dir}/\`${files.length ? `, ${files.join(', ')}` : ''}`,
    ].join('\n'),
    `#### ${ctx.word('headings', 'essentials')}`,
    essentials(c),
  ]);
}
// the storyline: its H1 and the text under it, up to its first ## section, verbatim
function storylineOpening() {
  const file = path.join(courseDir, course.storyline);
  const lines = read(file).split('\n');
  const at = lines.findIndex((l) => /^# /.test(l));
  if (at < 0) fail(`${course.storyline} has no title « # <titre> »`);
  const end = lines.findIndex((l, i) => i > at && /^#{1,2} /.test(l));
  const text = lines.slice(at + 1, end < 0 ? lines.length : end).join('\n').trim();
  if (!text) fail(`${course.storyline} has no text under its title`);
  return { title: lines[at].replace(/^# /, '').trim(), text };
}
function courseMap() {
  const storyline = storylineOpening();
  const domains = (course.domains || []).map((d) => blocks([
    `## ${domainTitle(d)}`,
    [`- ${MAP.objective} : ${d.objective}`, `- ${MAP.file} : \`course/${d.file}\``].join('\n'),
    ...(d.concepts || []).map((n) => {
      const c = concepts.get(String(n));
      if (!c) fail(`course.yaml: domain ${d.number} names concept ${n}, which is not in concepts`);
      return conceptEntry(c);
    }),
  ]));
  const annexes = ctx.concepts.filter((c) => c.annex);
  const others = [
    `- \`course/plan.md\` : la posture, le public cible, les questions d'accueil et les partis pris`,
    `- \`course/${course.storyline}\` : le fil rouge`,
    `- \`course/${course.glossary}\` : le glossaire, un terme par notion`,
  ].join('\n');
  return {
    file: COURSE_MAP_FILE,
    text: blocks([
      `# ${MAP.title} : ${course.title}`,
      MAP.intro,
      `## ${slot(lex('phrases', 'storyline_title'), { title: storyline.title })}`,
      `- ${MAP.file} : \`course/${course.storyline}\``,
      storyline.text,
      ...domains,
      ...(annexes.length ? [`## ${MAP.annexes}`, ...annexes.map(conceptEntry)] : []),
      `## ${MAP.others}`,
      others,
    ]) + '\n',
  };
}

// ---- what a moment reads: its draws from the course and from learner memory, as paths in the
// classroom (the course is copied into course/, learner memory is learner/: composition.yaml)
const SLOTS = {
  '<dir>': `the folder of the concept at hand, under \`course/\`, as the course map (\`${COURSE_MAP_FILE}\`) gives it`,
  '<file>': `the file of the domain at hand, under \`course/\`, as the course map (\`${COURSE_MAP_FILE}\`) gives it`,
};
// A draw from a course file with no slot whose `what` names a heading (`headings.onboarding`) is
// rendered with the section under that heading, `text`, so that the moment needs no read: the
// onboarding questions of plan.md reach the onboarding with no tool call before its first message
// (instruction first-message-without-tools; a finding of the fresh test onboarding, #507).
function section(file, heading) {
  const lines = read(file).split('\n');
  const at = lines.findIndex((l) => l.trim() === `## ${heading}`);
  if (at < 0) fail(`${path.basename(file)} has no heading « ## ${heading} »`);
  const body = [];
  for (const l of lines.slice(at + 1)) {
    if (/^#{1,2} /.test(l)) break;
    body.push(l);
  }
  return body.join('\n').trim();
}
function draws(list) {
  return (list || []).map((d) => {
    const source = fill(d.source, 'composition.yaml');
    const where = d.from === 'course' ? `course/${source}` : d.from === 'learner' ? `learner/${source}` : null;
    if (!where) return null;
    const out = { path: where, what: fillWhat(d.what) };
    const heading = /\bheadings\.([a-z_]+)\b/.exec(d.what);
    if (d.from === 'course' && heading && !/[<{]/.test(source)) out.text = section(path.join(courseDir, source), lex('headings', heading[1]));
    return out;
  }).filter(Boolean);
}

// ---- the permissions: the classroom draws of the part, « peut s'écrire » (may be written, « se
// commite »: committed, « ne se pousse jamais »: never pushed) or « en lecture seule » (read only);
// the `what` texts are French (decision language-policy)
const permissions = { writable: [], read_only: [], commit: false, push: false };
for (const d of parts.get('permissions').draws || []) {
  if (d.from !== 'classroom') continue;
  if (/^peut s'écrire/.test(d.what)) {
    permissions.writable.push(d.source);
    if (/se commite/.test(d.what)) permissions.commit = true;
    if (/se pousse/.test(d.what) && !/ne se pousse jamais/.test(d.what)) permissions.push = true;
  } else if (/^en lecture seule/.test(d.what)) permissions.read_only.push(d.source);
  else fail(`composition.yaml: permissions: ${d.source} is neither « peut s'écrire » nor « en lecture seule »`);
}

// ---- the parts
const learnerTemplates = fs.readdirSync(LEARNER_TEMPLATES).filter((x) => x.endsWith('.md')).sort()
  .map((name) => ({ name, text: read(path.join(LEARNER_TEMPLATES, name)) }));
const rendered = {
  spec: SPEC,
  permanent: {
    instructions: permanentInstructions(),
    posture: posture(),
    course_map: courseMap(),
  },
  moments: moments.map((m) => {
    const reads = draws(m.draws);
    return {
      id: m.id,
      when: m.when,
      draws: reads,
      slots: Object.keys(SLOTS).filter((s) => reads.some((r) => r.path.includes(s))).map((s) => ({ slot: s, meaning: SLOTS[s] })),
      instructions: momentInstructions(m),
    };
  }),
  learner_templates: learnerTemplates,
  permissions,
  params: PARAMS,
};
process.stdout.write(JSON.stringify(rendered, null, 2) + '\n');
