#!/usr/bin/env node
// plan-to-issues: create one GitHub issue per task of a stage file (construction/plan/stage-N.md).
//
//   plan-to-issues [--dry-run] [--repo owner/name] <stage-file>...
//
// A task is a "### " heading followed by a metadata line `area=... type=... model=...
// depends=... parallel=...` in backticks, then the bullets. Issue: title = heading text,
// body = the bullets, labels `area:<area>` and `type:<type>`, milestone `stage-N` (from the file
// name); `depends` becomes blocked-by links (decision blocked-by-links-for-dependencies), set once
// every issue of the run exists. Idempotent: a task whose title already exists (any state) is
// not created again, and only its missing links are set. Tasks `S<n>-<nn>.<mm>` become
// sub-issues of `S<n>-<nn>`. No dependency; runs `gh`
// (use `mise exec -- plan-to-issues ...` so that gh has its credentials).
'use strict';
const { execFileSync } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');

const args = process.argv.slice(2);
let dry = false;
let repo = 'sebvey/feyn';
const files = [];
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--dry-run') dry = true;
  else if (args[i] === '--repo') repo = args[++i];
  else files.push(args[i]);
}
if (!files.length) {
  console.error('usage: plan-to-issues [--dry-run] [--repo owner/name] <stage-file>...');
  process.exit(2);
}

function gh(argv, input) {
  return execFileSync('gh', argv, { encoding: 'utf8', input, stdio: ['pipe', 'pipe', 'pipe'] });
}

function parse(file) {
  const m = path.basename(file).match(/^stage-(\d+)\.md$/);
  if (!m) throw new Error(`${file}: expected a file named stage-<n>.md`);
  const milestone = `stage-${m[1]}`;
  const tasks = [];
  let cur = null;
  for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
    if (/^### /.test(line)) {
      cur = { title: line.slice(4).trim(), meta: null, body: [], milestone };
      cur.id = cur.title.split(/\s+/)[0];
      tasks.push(cur);
    } else if (cur) {
      if (/^#{1,2} /.test(line)) cur = null;
      else if (!cur.meta && /^`[^`]*=[^`]*`\s*$/.test(line)) {
        cur.meta = Object.fromEntries(
          line.trim().slice(1, -1).split(/\s+/).map((kv) => [kv.slice(0, kv.indexOf('=')), kv.slice(kv.indexOf('=') + 1)]),
        );
      } else if (cur.meta) cur.body.push(line);
    }
  }
  for (const t of tasks) {
    if (!t.meta) throw new Error(`${file}: task "${t.title}" has no metadata line`);
    // Drop progress ticks ("- [x] Done on ...") and trailing blank lines.
    const body = t.body.filter((l) => !/^- \[[ x]\]/.test(l));
    while (body.length && !body[body.length - 1].trim()) body.pop();
    t.depends = t.meta.depends && t.meta.depends !== '-' ? t.meta.depends.split(',') : [];
    t.text = `${body.join('\n')}\n`;
    t.labels = [`area:${t.meta.area}`, `type:${t.meta.type}`];
    const sub = t.id.match(/^(S\d+-\d+)\.\d+$/);
    t.parentId = sub ? sub[1] : null;
  }
  return tasks;
}

let existing = new Map();
try {
  const out = gh(['issue', 'list', '-R', repo, '--state', 'all', '--limit', '1000', '--json', 'number,title,id']);
  for (const i of JSON.parse(out)) existing.set(i.title, i);
} catch (e) {
  if (!dry) throw e;
  console.error('(dry run: could not list existing issues, assuming none)');
}

let created = 0;
let skipped = 0;
const toLink = [];
for (const file of files) {
  const tasks = parse(file);
  // Parents first, so that a sub-issue finds its parent in the same run.
  tasks.sort((a, b) => Number(!!a.parentId) - Number(!!b.parentId));
  for (const t of tasks) {
    const found = existing.get(t.title);
    const parent = t.parentId
      ? [...existing.values()].find((i) => i.title.split(/\s+/)[0] === t.parentId)
      : null;
    if (found) {
      console.log(`skip    #${found.number}  ${t.title}`);
      skipped++;
      toLink.push(t);
      continue;
    }
    const sub = t.parentId ? `  (sub-issue of ${t.parentId})` : '';
    console.log(`${dry ? 'would create' : 'create'}  ${t.title}  [${t.labels.join(', ')}]  milestone ${t.milestone}${sub}`);
    created++;
    toLink.push(t);
    if (dry) {
      existing.set(t.title, { number: 'new', title: t.title });
      continue;
    }
    const url = gh(
      ['issue', 'create', '-R', repo, '--title', t.title, '--body-file', '-', '--milestone', t.milestone, ...t.labels.flatMap((l) => ['--label', l])],
      t.text,
    ).trim();
    const number = Number(url.split('/').pop());
    const node = JSON.parse(gh(['api', `repos/${repo}/issues/${number}`]));
    existing.set(t.title, { number, title: t.title, id: node.id });
    if (parent) {
      gh(['api', '-X', 'POST', `repos/${repo}/issues/${parent.number}/sub_issues`, '-F', `sub_issue_id=${node.id}`]);
    } else if (t.parentId) {
      console.error(`warning: parent ${t.parentId} of ${t.id} not found; not linked`);
    }
  }
}
// Blocked-by links, once every issue of the run exists: a blocker may come later in the files.
const byId = (id) => [...existing.values()].find((i) => i.title.split(/\s+/)[0] === id);
let linked = 0;
for (const t of toLink) {
  const number = existing.get(t.title).number;
  let have = [];
  if (t.depends.length && number !== 'new') {
    try {
      have = JSON.parse(gh(['api', `repos/${repo}/issues/${number}/dependencies/blocked_by`])).map((i) => i.number);
    } catch (e) {
      if (!dry) throw e;
    }
  }
  for (const d of t.depends) {
    const blocker = byId(d);
    if (!blocker) {
      console.error(`warning: ${t.id} is blocked by ${d}, which has no issue; not linked`);
      continue;
    }
    if (have.includes(blocker.number)) continue;
    console.log(`${dry ? 'would link' : 'link'}    ${t.id} blocked by ${d} (#${blocker.number})`);
    linked++;
    if (dry) continue;
    const blockerId = JSON.parse(gh(['api', `repos/${repo}/issues/${blocker.number}`])).id;
    gh(['api', '-X', 'POST', `repos/${repo}/issues/${number}/dependencies/blocked_by`, '-F', `issue_id=${blockerId}`]);
  }
}
console.log(`${dry ? 'dry run: ' : ''}${created} to create/created, ${skipped} skipped, ${linked} links`);
